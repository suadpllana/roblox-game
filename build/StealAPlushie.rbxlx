        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Central tuning file. Almost everything you will want to change lives here:
	game pass / developer product IDs, prices shown in the shop, economy balance,
	base sizes, conveyor speed, and so on.

	AFTER PUBLISHING: create the game passes and developer products on
	https://create.roblox.com (your experience -> Monetization) and paste each ID
	into the `Id` fields below. While an Id is 0, buying it inside Roblox Studio
	grants it for free so you can test; in a live server it shows "not set up yet".
]]

local Config = {}

Config.GameName = "Steal a Plushie"

-- Bump the version suffix only if you want to wipe everyone's progress.
Config.DataStoreName = "PlayerData_v1"
Config.LeaderboardStoreName = "TopEarners_v1"

-- Optional: put your Roblox group ID here. Group members get a cash bonus,
-- which is the cheapest way to grow a community you can message later.
Config.GroupId = 0

Config.StartingCash = 100
Config.StartingPlushie = "LilBean"

Config.Base = {
	Count = 8, -- set the place's Max Players to 8 so everyone gets a base
	StartSlots = 8,
	SlotsPerRebirth = 1,
	MaxRebirthSlots = 6,
	ExtraSlotsPass = 6,
	LockDuration = 60,
	SuperLockDuration = 120,
	NewPlayerProtection = 90, -- seconds after joining before your base can be robbed
}

Config.Steal = {
	HoldDuration = 1.5,
	CarryWalkSpeed = 12,
	OwnerTagDistance = 6, -- owner touching the thief takes the plushie back
}

Config.Movement = {
	WalkSpeed = 16,
	SpeedPassWalkSpeed = 22,
}

Config.Conveyor = {
	SpawnInterval = 2.2,
	Speed = 5, -- studs per second
	MaxItems = 22,
	AnnounceRarities = { Mythic = true, Secret = true },
}

Config.Economy = {
	RebirthBaseCost = 1_000_000,
	RebirthCostGrowth = 3,
	RebirthMultiplierBonus = 0.5,
	SellRefund = 0.5,
	VIPMultiplier = 1.25,
	DoubleCashMultiplier = 2,
	PremiumMultiplier = 1.1,
	GroupMultiplier = 1.1,
	FriendBonusPer = 0.1,
	FriendBonusMax = 0.5,
}

Config.Offline = {
	Rate = 0.25,
	CapHours = 8,
	PassRate = 1,
	PassCapHours = 24,
}

Config.Daily = {
	BaseReward = 250, -- multiplied by the streak day
	IncomeSeconds = 90, -- reward also scales with your income so it never feels useless
	MysteryBoxDay = 7,
}

Config.ServerLuck = {
	Multiplier = 2,
	Duration = 15 * 60,
}

Config.Shield = {
	Duration = 30 * 60,
}

-- Game passes: one-time purchases. Order controls shop order.
Config.GamePasses = {
	{
		Key = "VIP",
		Id = 0,
		Name = "VIP",
		Price = 199,
		Icon = "👑",
		Description = "+25% cash forever, gold [VIP] chat tag.",
	},
	{
		Key = "DoubleCash",
		Id = 0,
		Name = "2x Cash",
		Price = 299,
		Icon = "💰",
		Description = "Every plushie earns double, forever.",
	},
	{
		Key = "AutoCollect",
		Id = 0,
		Name = "Auto Collect",
		Price = 99,
		Icon = "🧲",
		Description = "Cash goes straight to your wallet. No pad needed.",
	},
	{
		Key = "ExtraSlots",
		Id = 0,
		Name = "+6 Base Slots",
		Price = 149,
		Icon = "📦",
		Description = "Room for 6 more plushies in your base.",
	},
	{
		Key = "SuperLock",
		Id = 0,
		Name = "Super Lock",
		Price = 99,
		Icon = "🔒",
		Description = "Your base lock lasts twice as long.",
	},
	{
		Key = "OfflineEarnings",
		Id = 0,
		Name = "Offline Earnings+",
		Price = 129,
		Icon = "🌙",
		Description = "Earn 100% while offline (up to 24h) instead of 25% / 8h.",
	},
	{
		Key = "Speed",
		Id = 0,
		Name = "Speed Boost",
		Price = 79,
		Icon = "⚡",
		Description = "Run faster. Perfect for getaways.",
	},
}

-- Developer products: can be bought again and again.
-- Kind = "Cash": gives max(Floor, your income per second * Seconds), so packs stay
-- valuable no matter how far a player has progressed.
Config.Products = {
	{
		Key = "CashSmall",
		Id = 0,
		Name = "Pile of Cash",
		Price = 25,
		Icon = "💵",
		Kind = "Cash",
		Seconds = 5 * 60,
		Floor = 1_000,
		Description = "5 minutes of income instantly.",
	},
	{
		Key = "CashMedium",
		Id = 0,
		Name = "Bag of Cash",
		Price = 79,
		Icon = "💰",
		Kind = "Cash",
		Seconds = 20 * 60,
		Floor = 5_000,
		Description = "20 minutes of income instantly.",
	},
	{
		Key = "CashLarge",
		Id = 0,
		Name = "Vault of Cash",
		Price = 199,
		Icon = "🏦",
		Kind = "Cash",
		Seconds = 60 * 60,
		Floor = 25_000,
		Description = "1 hour of income instantly.",
	},
	{
		Key = "ServerLuck",
		Id = 0,
		Name = "2x Server Luck",
		Price = 99,
		Icon = "🍀",
		Kind = "ServerLuck",
		Description = "Rare+ plushies spawn 2x more for EVERYONE for 15 min. Stacks!",
	},
	{
		Key = "MysteryBox",
		Id = 0,
		Name = "Mystery Plushie Box",
		Price = 129,
		Icon = "🎁",
		Kind = "MysteryBox",
		Description = "Instantly get a random Epic or better plushie.",
	},
	{
		Key = "Shield",
		Id = 0,
		Name = "Steal Shield",
		Price = 49,
		Icon = "🛡️",
		Kind = "Shield",
		Description = "Nobody can steal from your base for 30 minutes.",
	},
}

function Config.GetPass(key: string)
	for _, pass in Config.GamePasses do
		if pass.Key == key then
			return pass
		end
	end
	return nil
end

function Config.GetProduct(key: string)
	for _, product in Config.Products do
		if product.Key == key then
			return product
		end
	end
	return nil
end

function Config.RebirthCost(rebirths: number): number
	return Config.Economy.RebirthBaseCost * Config.Economy.RebirthCostGrowth ^ rebirths
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trimZeros(text: string): string
	if string.find(text, ".", 1, true) then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

function Format.Number(value: number): string
	if value ~= value or value == math.huge or value == -math.huge then
		return "0"
	end
	local sign = if value < 0 then "-" else ""
	value = math.abs(value)
	if value < 1000 then
		if value % 1 == 0 then
			return sign .. tostring(math.floor(value))
		end
		return sign .. trimZeros(string.format("%.1f", math.floor(value * 10) / 10))
	end
	local index = math.min(math.floor(math.log10(value) / 3), #SUFFIXES - 1)
	local scaled = value / 10 ^ (index * 3)
	local text
	if scaled >= 100 then
		text = tostring(math.floor(scaled))
	elseif scaled >= 10 then
		text = trimZeros(string.format("%.1f", math.floor(scaled * 10) / 10))
	else
		text = trimZeros(string.format("%.2f", math.floor(scaled * 100) / 100))
	end
	return sign .. text .. SUFFIXES[index + 1]
end

function Format.Cash(value: number): string
	return "$" .. Format.Number(value)
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %02ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Plushies</string>
          <string name="Source"><![CDATA[--[[
	The plushie catalog. Add, rename or rebalance plushies here.

	Shape controls the placeholder model built from parts: Bear, Bunny, Cat, Frog,
	Bird, Fish, Unicorn, Blob. To use a real 3D model instead, put a Model named
	exactly like the plushie's Id inside ServerStorage > PlushieModels and it will
	be used automatically.
]]

local Plushies = {}

Plushies.Rarities = {
	{ Name = "Common", Weight = 55, Color = Color3.fromRGB(200, 200, 200), Lucky = false },
	{ Name = "Uncommon", Weight = 25, Color = Color3.fromRGB(110, 220, 110), Lucky = false },
	{ Name = "Rare", Weight = 12, Color = Color3.fromRGB(80, 160, 255), Lucky = true },
	{ Name = "Epic", Weight = 5.5, Color = Color3.fromRGB(190, 90, 255), Lucky = true },
	{ Name = "Legendary", Weight = 2, Color = Color3.fromRGB(255, 190, 40), Lucky = true },
	{ Name = "Mythic", Weight = 0.45, Color = Color3.fromRGB(255, 70, 110), Lucky = true },
	{ Name = "Secret", Weight = 0.05, Color = Color3.fromRGB(30, 30, 30), Lucky = true },
}

Plushies.Mutations = {
	{ Name = "Gold", Multiplier = 2, Chance = 0.04, Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Foil },
	{ Name = "Diamond", Multiplier = 3, Chance = 0.015, Color = Color3.fromRGB(120, 230, 255), Material = Enum.Material.Glass },
	{ Name = "Rainbow", Multiplier = 5, Chance = 0.004, Color = Color3.fromRGB(255, 80, 80), Material = Enum.Material.Neon },
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Plushies.List = {
	-- Common
	{ Id = "LilBean", Name = "Lil Bean", Rarity = "Common", Price = 25, Income = 1, Shape = "Blob", Color = rgb(130, 205, 95), Accent = rgb(80, 150, 60) },
	{ Id = "SockBunny", Name = "Sock Bunny", Rarity = "Common", Price = 60, Income = 2, Shape = "Bunny", Color = rgb(235, 235, 245), Accent = rgb(255, 170, 190) },
	{ Id = "ButtonBear", Name = "Button Bear", Rarity = "Common", Price = 150, Income = 4, Shape = "Bear", Color = rgb(170, 120, 80), Accent = rgb(230, 200, 160) },
	-- Uncommon
	{ Id = "MochiCat", Name = "Mochi Cat", Rarity = "Uncommon", Price = 500, Income = 10, Shape = "Cat", Color = rgb(255, 222, 232), Accent = rgb(255, 150, 180) },
	{ Id = "PuddingPup", Name = "Pudding Pup", Rarity = "Uncommon", Price = 900, Income = 16, Shape = "Bear", Color = rgb(245, 205, 120), Accent = rgb(140, 80, 40) },
	{ Id = "CloudSheep", Name = "Cloud Sheep", Rarity = "Uncommon", Price = 1_500, Income = 24, Shape = "Blob", Color = rgb(250, 250, 255), Accent = rgb(90, 90, 110) },
	-- Rare
	{ Id = "TacoTurtle", Name = "Taco Turtle", Rarity = "Rare", Price = 5_000, Income = 60, Shape = "Blob", Color = rgb(245, 185, 70), Accent = rgb(90, 180, 70) },
	{ Id = "BubbleFrog", Name = "Bubble Frog", Rarity = "Rare", Price = 9_000, Income = 95, Shape = "Frog", Color = rgb(110, 210, 120), Accent = rgb(255, 240, 160) },
	{ Id = "CactusKitty", Name = "Cactus Kitty", Rarity = "Rare", Price = 15_000, Income = 140, Shape = "Cat", Color = rgb(95, 170, 95), Accent = rgb(255, 120, 170) },
	-- Epic
	{ Id = "NinjaPanda", Name = "Ninja Panda", Rarity = "Epic", Price = 50_000, Income = 350, Shape = "Bear", Color = rgb(245, 245, 245), Accent = rgb(25, 25, 30) },
	{ Id = "DiscoDuck", Name = "Disco Duck", Rarity = "Epic", Price = 90_000, Income = 550, Shape = "Bird", Color = rgb(255, 222, 50), Accent = rgb(255, 140, 30) },
	{ Id = "AstroAxolotl", Name = "Astro Axolotl", Rarity = "Epic", Price = 150_000, Income = 800, Shape = "Frog", Color = rgb(255, 160, 205), Accent = rgb(150, 90, 230) },
	-- Legendary
	{ Id = "KingCorgi", Name = "King Corgi", Rarity = "Legendary", Price = 500_000, Income = 2_500, Shape = "Cat", Color = rgb(235, 150, 70), Accent = rgb(255, 245, 230), Hat = "Crown" },
	{ Id = "DragonPlush", Name = "Dragon Plush", Rarity = "Legendary", Price = 900_000, Income = 4_000, Shape = "Unicorn", Color = rgb(60, 180, 90), Accent = rgb(255, 210, 60) },
	{ Id = "PizzaShark", Name = "Pizza Shark", Rarity = "Legendary", Price = 1_500_000, Income = 6_000, Shape = "Fish", Color = rgb(110, 140, 170), Accent = rgb(230, 70, 50) },
	-- Mythic
	{ Id = "GalaxyUnicorn", Name = "Galaxy Unicorn", Rarity = "Mythic", Price = 5_000_000, Income = 22_000, Shape = "Unicorn", Color = rgb(120, 70, 220), Accent = rgb(255, 120, 230), Material = Enum.Material.Neon },
	{ Id = "PhoenixChick", Name = "Phoenix Chick", Rarity = "Mythic", Price = 10_000_000, Income = 40_000, Shape = "Bird", Color = rgb(255, 120, 30), Accent = rgb(255, 230, 60), Material = Enum.Material.Neon },
	{ Id = "CrystalKraken", Name = "Crystal Kraken", Rarity = "Mythic", Price = 20_000_000, Income = 70_000, Shape = "Fish", Color = rgb(90, 220, 255), Accent = rgb(200, 255, 255), Material = Enum.Material.Glass },
	-- Secret
	{ Id = "VoidBunny", Name = "Void Bunny", Rarity = "Secret", Price = 100_000_000, Income = 300_000, Shape = "Bunny", Color = rgb(20, 10, 35), Accent = rgb(170, 60, 255), Material = Enum.Material.Neon, Scale = 1.2 },
	{ Id = "GoldenGoose", Name = "Golden Goose", Rarity = "Secret", Price = 250_000_000, Income = 650_000, Shape = "Bird", Color = rgb(255, 205, 40), Accent = rgb(255, 255, 255), Material = Enum.Material.Foil, Scale = 1.25, Hat = "Crown" },
	{ Id = "OmegaBear", Name = "Omega Bear", Rarity = "Secret", Price = 500_000_000, Income = 1_200_000, Shape = "Bear", Color = rgb(255, 60, 60), Accent = rgb(255, 255, 255), Material = Enum.Material.Neon, Scale = 1.35, Hat = "Crown" },
}

local byId = {}
local byRarity = {}
for _, def in Plushies.List do
	byId[def.Id] = def
	byRarity[def.Rarity] = byRarity[def.Rarity] or {}
	table.insert(byRarity[def.Rarity], def)
end

local rarityByName = {}
for index, rarity in Plushies.Rarities do
	rarity.Order = index
	rarityByName[rarity.Name] = rarity
end

local mutationByName = {}
for _, mutation in Plushies.Mutations do
	mutationByName[mutation.Name] = mutation
end

function Plushies.Get(id: string)
	return byId[id]
end

function Plushies.GetRarity(name: string)
	return rarityByName[name]
end

function Plushies.GetMutation(name: string?)
	if not name or name == "None" then
		return nil
	end
	return mutationByName[name]
end

function Plushies.ByRarity(name: string)
	return byRarity[name] or {}
end

function Plushies.MutationMultiplier(name: string?): number
	local mutation = Plushies.GetMutation(name)
	return if mutation then mutation.Multiplier else 1
end

function Plushies.GetIncome(id: string, mutation: string?): number
	local def = byId[id]
	if not def then
		return 0
	end
	return def.Income * Plushies.MutationMultiplier(mutation)
end

function Plushies.GetPrice(id: string, mutation: string?): number
	local def = byId[id]
	if not def then
		return 0
	end
	return def.Price * Plushies.MutationMultiplier(mutation)
end

function Plushies.DisplayName(id: string, mutation: string?): string
	local def = byId[id]
	local name = if def then def.Name else id
	if mutation and mutation ~= "None" then
		return mutation .. " " .. name
	end
	return name
end

-- Picks a rarity by weight. `luck` multiplies the weight of rarities flagged Lucky.
function Plushies.RollRarity(rng: Random, luck: number, allowed: { [string]: number }?)
	local total = 0
	local weights = {}
	for _, rarity in Plushies.Rarities do
		local weight = rarity.Weight
		if allowed then
			weight = allowed[rarity.Name] or 0
		end
		if rarity.Lucky then
			weight *= luck
		end
		weights[rarity.Name] = weight
		total += weight
	end
	local roll = rng:NextNumber() * total
	for _, rarity in Plushies.Rarities do
		roll -= weights[rarity.Name]
		if roll <= 0 and weights[rarity.Name] > 0 then
			return rarity.Name
		end
	end
	return Plushies.Rarities[1].Name
end

function Plushies.RollMutation(rng: Random, luck: number): string
	-- Rarest first so a single roll can land the best result.
	for index = #Plushies.Mutations, 1, -1 do
		local mutation = Plushies.Mutations[index]
		if rng:NextNumber() < mutation.Chance * luck then
			return mutation.Name
		end
	end
	return "None"
end

function Plushies.RollPlushie(rng: Random, luck: number, allowed: { [string]: number }?)
	local rarity = Plushies.RollRarity(rng, luck, allowed)
	local options = byRarity[rarity]
	local def = options[rng:NextInteger(1, #options)]
	return def.Id, Plushies.RollMutation(rng, luck)
end

return Plushies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Single list of every remote so client and server never disagree on names.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	"Notify", -- server -> client: (text, kind)
	"Announce", -- server -> all clients: (text, color)
	"Knockback", -- server -> client: (velocity)
	"RequestPurchase", -- client -> server: (kind "Pass"|"Product", key)
	"RequestRebirth", -- client -> server
	"ClaimDaily", -- client -> server
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name = "Remotes"
		for _, name in EVENTS do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = created
		end
		created.Parent = ReplicatedStorage
		folder = created
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Remotes.Get(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point. Loads every service in a fixed order, then drives the
	player lifecycle so services always see a player's data in a consistent state.

	Service modules may implement:
		Init(services)              -- wire up references, create instances
		Start()                     -- start loops (runs in its own thread)
		OnPlayerLoaded(player, data)
		OnPlayerRemoving(player)
]]

local Players = game:GetService("Players")

local servicesFolder = script.Parent:WaitForChild("Services")

local ORDER = {
	"DataService",
	"MapBuilder",
	"MonetizationService",
	"EconomyService",
	"BaseService",
	"ConveyorService",
	"StealService",
	"CombatService",
	"RewardsService",
	"LeaderboardService",
}

local Services = {}
for _, name in ORDER do
	Services[name] = require(servicesFolder:WaitForChild(name))
end

for _, name in ORDER do
	local service = Services[name]
	if service.Init then
		service:Init(Services)
	end
end

for _, name in ORDER do
	local service = Services[name]
	if service.Start then
		task.spawn(service.Start, service)
	end
end

local function onPlayerAdded(player: Player)
	local data = Services.DataService:Load(player)
	if not data or not player.Parent then
		return
	end
	for _, name in ORDER do
		local service = Services[name]
		if name ~= "DataService" and service.OnPlayerLoaded then
			local ok, err = pcall(service.OnPlayerLoaded, service, player, data)
			if not ok then
				warn(`[{name}] OnPlayerLoaded failed for {player.Name}: {err}`)
			end
		end
	end
	player:SetAttribute("Loaded", true)
end

local function onPlayerRemoving(player: Player)
	for index = #ORDER, 1, -1 do
		local name = ORDER[index]
		local service = Services[name]
		if name ~= "DataService" and service.OnPlayerRemoving then
			local ok, err = pcall(service.OnPlayerRemoving, service, player)
			if not ok then
				warn(`[{name}] OnPlayerRemoving failed for {player.Name}: {err}`)
			end
		end
	end
	Services.DataService:Release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

game:BindToClose(function()
	Services.DataService:SaveAll()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--[[
	Owns the 8 player bases: assigning them, showing each player's plushies on
	their pedestals, selling, locking, collect pads, and keeping intruders out
	of locked bases.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Plushies = require(ReplicatedStorage.Shared.Plushies)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PlushieFactory = require(script.Parent.PlushieFactory)

local BaseService = {}

local Services
local MapBuilder
local DataService

local baseOf: { [Player]: any } = {}
local touchDebounce: { [Player]: { [string]: number } } = {}
local notify: RemoteEvent

local function now(): number
	return workspace:GetServerTimeNow()
end

local function playerFromHit(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return player
end

local function debounced(player: Player, pad: string): boolean
	local times = touchDebounce[player]
	if not times then
		times = {}
		touchDebounce[player] = times
	end
	local last = times[pad]
	if last and os.clock() - last < 0.5 then
		return true
	end
	times[pad] = os.clock()
	return false
end

local function collisionGroupFor(player: Player): string
	local base = baseOf[player]
	return if base then "Owner" .. base.Index else "Players"
end

local function applyCollisionGroup(player: Player, character: Model)
	local group = collisionGroupFor(player)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end
end

local function onCharacterAdded(player: Player, character: Model)
	applyCollisionGroup(player, character)
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = collisionGroupFor(player)
		end
	end)
	local base = baseOf[player]
	if base then
		local root = character:WaitForChild("HumanoidRootPart", 5)
		if root then
			task.wait(0.15)
			if character.Parent and baseOf[player] == base then
				character:PivotTo(base.SpawnCFrame)
			end
		end
	end
end

function BaseService:Init(services)
	Services = services
	MapBuilder = services.MapBuilder
	DataService = services.DataService
	notify = Remotes.Get("Notify")

	for _, base in MapBuilder.Bases do
		base.Owner = nil
		base.Models = {}
		base.Stealing = {}
		base.LockedUntil = 0
		local plushieFolder = Instance.new("Folder")
		plushieFolder.Name = "Plushies"
		plushieFolder.Parent = base.Folder
		base.PlushieFolder = plushieFolder

		base.CollectPad.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and baseOf[player] == base and not debounced(player, "collect") then
				Services.EconomyService:Collect(player)
			end
		end)
		base.LockPad.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and baseOf[player] == base and not debounced(player, "lock") then
				self:Lock(player)
			end
		end)
	end

	local function onPlayerAdded(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
end

function BaseService:Start()
	while true do
		task.wait(0.25)
		local t = now()
		for _, base in MapBuilder.Bases do
			local owner = base.Owner
			if not owner then
				continue
			end
			local data = DataService:Get(owner)
			if base.LockedUntil > 0 and t >= base.LockedUntil then
				self:_setLocked(base, false)
			end
			local locked = base.LockedUntil > t
			if locked then
				base.LockLabel.Text = `🔒 LOCKED {math.ceil(base.LockedUntil - t)}s`
				-- Anyone who was already inside when the lock went up gets pushed out.
				for _, player in Players:GetPlayers() do
					if player ~= owner and player.Character then
						local root = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
						if root and MapBuilder:IsInsideBase(base, root.Position) then
							Services.StealService:Drop(player, "pushed out of a locked base")
							player.Character:PivotTo(base.OutsideCFrame)
						end
					end
				end
			else
				base.LockLabel.Text = "🔒 LOCK BASE"
			end
			if data then
				base.CollectLabel.Text = "COLLECT\n" .. Format.Cash(data.Uncollected)
				local status = ""
				if (data.ShieldUntil or 0) > os.time() then
					status = "  🛡️"
				elseif locked then
					status = "  🔒"
				end
				for _, label in base.SignLabels do
					label.Text = owner.DisplayName .. "'s Base" .. status
				end
			end
		end
	end
end

function BaseService:GetBase(player: Player)
	return baseOf[player]
end

function BaseService:GetSlotCount(player: Player): number
	local data = DataService:Get(player)
	if not data then
		return 0
	end
	local count = Config.Base.StartSlots
		+ math.min(data.Rebirths * Config.Base.SlotsPerRebirth, Config.Base.MaxRebirthSlots)
	if Services.MonetizationService:HasPass(player, "ExtraSlots") then
		count += Config.Base.ExtraSlotsPass
	end
	return math.min(count, MapBuilder.MAX_SLOTS)
end

-- Plushies that are placed on an unlocked pedestal (the ones that earn money).
function BaseService:GetActiveEntries(player: Player)
	local data = DataService:Get(player)
	local active = {}
	if not data then
		return active
	end
	local count = self:GetSlotCount(player)
	for _, entry in data.Plushies do
		if entry.Slot >= 1 and entry.Slot <= count then
			table.insert(active, entry)
		end
	end
	return active
end

function BaseService:GetEntry(player: Player, slot: number)
	local data = DataService:Get(player)
	if not data then
		return nil, nil
	end
	for index, entry in data.Plushies do
		if entry.Slot == slot then
			return entry, index
		end
	end
	return nil, nil
end

function BaseService:FindFreeSlot(player: Player): number?
	local data = DataService:Get(player)
	if not data then
		return nil
	end
	local used = {}
	for _, entry in data.Plushies do
		used[entry.Slot] = true
	end
	for slot = 1, self:GetSlotCount(player) do
		if not used[slot] then
			return slot
		end
	end
	return nil
end

-- Fixes duplicate / missing slot numbers (e.g. after a pass was refunded).
function BaseService:_normalizeSlots(player: Player)
	local data = DataService:Get(player)
	local count = self:GetSlotCount(player)
	local used = {}
	local homeless = {}
	for _, entry in data.Plushies do
		if type(entry.Slot) ~= "number" or entry.Slot < 1 or entry.Slot > count or used[entry.Slot] then
			table.insert(homeless, entry)
		else
			used[entry.Slot] = true
		end
	end
	for _, entry in homeless do
		entry.Slot = 0
		for slot = 1, count do
			if not used[slot] then
				entry.Slot = slot
				used[slot] = true
				break
			end
		end
	end
end

function BaseService:_clearSlot(base, slot: number)
	local model = base.Models[slot]
	if model then
		model:Destroy()
		base.Models[slot] = nil
	end
end

function BaseService:RenderSlot(player: Player, slot: number)
	local base = baseOf[player]
	if not base then
		return
	end
	self:_clearSlot(base, slot)
	local pedestal = base.Pedestals[slot]
	local count = self:GetSlotCount(player)
	pedestal.LockedGui.Enabled = slot > count
	pedestal.Part.Transparency = if slot > count then 0.6 else 0
	if slot > count or base.Stealing[slot] then
		return
	end
	local entry = self:GetEntry(player, slot)
	if not entry then
		return
	end
	local model = PlushieFactory.Build(entry.Id, entry.Mutation, "Static", pedestal.StandCFrame)
	if not model then
		return
	end
	local root = model.PrimaryPart :: BasePart

	local sellValue = Plushies.GetPrice(entry.Id, entry.Mutation) * Config.Economy.SellRefund
	local sell = Instance.new("ProximityPrompt")
	sell.Name = "SellPrompt"
	sell.ActionText = "Sell " .. Format.Cash(sellValue)
	sell.ObjectText = Plushies.DisplayName(entry.Id, entry.Mutation)
	sell.HoldDuration = 0.8
	sell.MaxActivationDistance = 8
	sell.RequiresLineOfSight = false
	sell.KeyboardKeyCode = Enum.KeyCode.F
	sell:SetAttribute("OwnerId", player.UserId)
	CollectionService:AddTag(sell, "OwnerOnlyPrompt")
	sell.Parent = root
	sell.Triggered:Connect(function(who)
		if who == player then
			self:Sell(player, slot)
		end
	end)

	local steal = Instance.new("ProximityPrompt")
	steal.Name = "StealPrompt"
	steal.ActionText = "Steal"
	steal.ObjectText = Plushies.DisplayName(entry.Id, entry.Mutation)
	steal.HoldDuration = Config.Steal.HoldDuration
	steal.MaxActivationDistance = 8
	steal.RequiresLineOfSight = false
	steal:SetAttribute("OwnerId", player.UserId)
	CollectionService:AddTag(steal, "OthersOnlyPrompt")
	steal.Parent = root
	steal.Triggered:Connect(function(thief)
		Services.StealService:TryStart(thief, player, slot)
	end)

	model.Parent = base.PlushieFolder
	base.Models[slot] = model
end

function BaseService:RenderAll(player: Player)
	if not baseOf[player] then
		return
	end
	for slot = 1, MapBuilder.MAX_SLOTS do
		self:RenderSlot(player, slot)
	end
end

function BaseService:AddPlushie(player: Player, id: string, mutation: string?): boolean
	local data = DataService:Get(player)
	local slot = self:FindFreeSlot(player)
	if not data or not slot then
		return false
	end
	table.insert(data.Plushies, { Id = id, Mutation = mutation or "None", Slot = slot })
	self:RenderSlot(player, slot)
	Services.EconomyService:RefreshStats(player)
	return true
end

function BaseService:RemovePlushie(player: Player, slot: number)
	local data = DataService:Get(player)
	local entry, index = self:GetEntry(player, slot)
	if not data or not entry then
		return nil
	end
	table.remove(data.Plushies, index)
	local base = baseOf[player]
	if base then
		base.Stealing[slot] = nil
		self:_clearSlot(base, slot)
	end
	Services.EconomyService:RefreshStats(player)
	return entry
end

function BaseService:Sell(player: Player, slot: number)
	local base = baseOf[player]
	if not base or base.Stealing[slot] then
		return
	end
	local entry = self:RemovePlushie(player, slot)
	if not entry then
		return
	end
	local value = Plushies.GetPrice(entry.Id, entry.Mutation) * Config.Economy.SellRefund
	Services.EconomyService:AddCash(player, value)
	notify:FireClient(player, `Sold {Plushies.DisplayName(entry.Id, entry.Mutation)} for {Format.Cash(value)}`, "cash")
end

function BaseService:_setLocked(base, locked: boolean)
	base.Barrier.Transparency = if locked then 0.55 else 1
	base.Barrier.CanCollide = locked
	if not locked then
		base.LockedUntil = 0
	end
	if base.Owner then
		base.Owner:SetAttribute("LockedUntil", base.LockedUntil)
	end
end

function BaseService:Lock(player: Player)
	local base = baseOf[player]
	if not base then
		return
	end
	if base.LockedUntil > now() then
		return
	end
	local duration = if Services.MonetizationService:HasPass(player, "SuperLock")
		then Config.Base.SuperLockDuration
		else Config.Base.LockDuration
	base.LockedUntil = now() + duration
	self:_setLocked(base, true)
	notify:FireClient(player, `Base locked for {duration}s!`, "info")
end

function BaseService:IsLocked(player: Player): boolean
	local base = baseOf[player]
	return base ~= nil and base.LockedUntil > now()
end

-- Why `owner` can't be robbed right now, or nil if they can.
function BaseService:GetProtectionReason(owner: Player): string?
	local data = DataService:Get(owner)
	if not data then
		return "That base isn't ready yet"
	end
	if self:IsLocked(owner) then
		return "That base is locked!"
	end
	if (data.ShieldUntil or 0) > os.time() then
		return "That base has a Steal Shield!"
	end
	if (owner:GetAttribute("ProtectedUntil") or 0) > now() then
		return "That player just joined - give them a minute!"
	end
	return nil
end

function BaseService:IsInOwnBase(player: Player): boolean
	local base = baseOf[player]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return base ~= nil and root ~= nil and MapBuilder:IsInsideBase(base, root.Position)
end

function BaseService:OnPlayerLoaded(player: Player)
	local free
	for _, base in MapBuilder.Bases do
		if not base.Owner then
			free = base
			break
		end
	end
	if not free then
		notify:FireClient(player, "All bases are taken in this server - try another server!", "error")
		return
	end
	free.Owner = player
	free.LockedUntil = 0
	free.Stealing = {}
	baseOf[player] = free
	player:SetAttribute("BaseIndex", free.Index)
	player:SetAttribute("ProtectedUntil", now() + Config.Base.NewPlayerProtection)
	self:_normalizeSlots(player)
	self:RenderAll(player)

	if player.Character then
		applyCollisionGroup(player, player.Character)
		player.Character:PivotTo(free.SpawnCFrame)
	end
end

function BaseService:OnPlayerRemoving(player: Player)
	touchDebounce[player] = nil
	local base = baseOf[player]
	if not base then
		return
	end
	for slot in base.Models do
		self:_clearSlot(base, slot)
	end
	base.Owner = nil
	base.Stealing = {}
	self:_setLocked(base, false)
	base.CollectLabel.Text = "COLLECT\n$0"
	base.LockLabel.Text = "🔒 LOCK BASE"
	for _, label in base.SignLabels do
		label.Text = "Empty Base"
	end
	for _, pedestal in base.Pedestals do
		pedestal.LockedGui.Enabled = false
		pedestal.Part.Transparency = 0
	end
	baseOf[player] = nil
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--[[
	Everyone spawns with a Bonk Bat. Hitting a thief makes them drop the plushie
	they're carrying; hitting anyone knocks them back.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPack = game:GetService("StarterPack")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local TOOL_NAME = "Bonk Bat"
local COOLDOWN = 0.7
local RANGE = 9
local GRIP = CFrame.new(0, -1.3, 0)

local CombatService = {}

local Services
local knockback: RemoteEvent
local lastSwing: { [Player]: number } = {}
local hooked = setmetatable({}, { __mode = "k" })

local function buildTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = "Bonk thieves to make them drop your plushie!"
	tool.CanBeDropped = false
	tool.Grip = GRIP

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.45, 3.2, 0.45)
	handle.Color = Color3.fromRGB(150, 100, 60)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local barrel = Instance.new("Part")
	barrel.Name = "Barrel"
	barrel.Shape = Enum.PartType.Cylinder
	barrel.Size = Vector3.new(1.8, 1, 1)
	barrel.CFrame = handle.CFrame * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.rad(90))
	barrel.Color = Color3.fromRGB(255, 120, 170)
	barrel.Material = Enum.Material.SmoothPlastic
	barrel.CanCollide = false
	barrel.Massless = true
	barrel.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = barrel
	weld.Parent = barrel

	local sound = Instance.new("Sound")
	sound.Name = "Swing"
	sound.SoundId = "rbxasset://sounds/swordslash.wav"
	sound.Volume = 0.6
	sound.Parent = handle

	return tool
end

function CombatService:_swing(player: Player, tool: Tool)
	local last = lastSwing[player]
	if last and os.clock() - last < COOLDOWN then
		return
	end
	lastSwing[player] = os.clock()

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	local handle = tool:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild("Swing") :: Sound?
	if sound then
		sound:Play()
	end
	tool.Grip = GRIP * CFrame.Angles(math.rad(-90), 0, 0)
	task.delay(0.2, function()
		tool.Grip = GRIP
	end)

	for _, other in Players:GetPlayers() do
		if other == player or not other.Character then
			continue
		end
		local otherRoot = other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local otherHumanoid = other.Character:FindFirstChildOfClass("Humanoid")
		if not otherRoot or not otherHumanoid or otherHumanoid.Health <= 0 then
			continue
		end
		local offset = otherRoot.Position - root.Position
		local distance = offset.Magnitude
		if distance > RANGE or distance < 0.01 then
			continue
		end
		local direction = offset.Unit
		if distance > 4 and root.CFrame.LookVector:Dot(direction) < 0.2 then
			continue
		end
		local flat = Vector3.new(direction.X, 0, direction.Z)
		flat = if flat.Magnitude > 0 then flat.Unit else root.CFrame.LookVector
		knockback:FireClient(other, flat * 55 + Vector3.new(0, 30, 0))
		if Services.StealService:IsCarrying(other) then
			Services.StealService:Drop(other, `bonked by {player.DisplayName}`)
		end
	end
end

function CombatService:_hookTool(player: Player, tool: Instance)
	if not tool:IsA("Tool") or tool.Name ~= TOOL_NAME or hooked[tool] then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		self:_swing(player, tool)
	end)
end

function CombatService:Init(services)
	Services = services
	knockback = Remotes.Get("Knockback")

	if not StarterPack:FindFirstChild(TOOL_NAME) then
		buildTool().Parent = StarterPack
	end

	local function watch(player: Player)
		local function watchContainer(container: Instance)
			for _, child in container:GetChildren() do
				self:_hookTool(player, child)
			end
			container.ChildAdded:Connect(function(child)
				self:_hookTool(player, child)
			end)
		end
		local backpack = player:WaitForChild("Backpack", 10)
		if backpack then
			watchContainer(backpack)
		end
		player.CharacterAdded:Connect(function(character)
			watchContainer(character)
			local newBackpack = player:WaitForChild("Backpack", 10)
			if newBackpack and newBackpack ~= backpack then
				backpack = newBackpack
				watchContainer(newBackpack)
			end
		end)
		if player.Character then
			watchContainer(player.Character)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(watch, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(watch, player)
	end
end

function CombatService:OnPlayerRemoving(player: Player)
	lastSwing[player] = nil
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">ConveyorService</string>
            <string name="Source"><![CDATA[--[[
	Spawns random plushies at the factory end of the lane and slides them along
	the conveyor. Anyone can buy one while it passes by - first come, first served.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Plushies = require(ReplicatedStorage.Shared.Plushies)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PlushieFactory = require(script.Parent.PlushieFactory)

local ConveyorService = {}

local Services
local MapBuilder
local notify: RemoteEvent
local announce: RemoteEvent
local folder: Folder
local rng = Random.new()
local items = {}

local function removeItem(item)
	local index = table.find(items, item)
	if index then
		table.remove(items, index)
	end
	if item.Model then
		item.Model:Destroy()
		item.Model = nil
	end
end

function ConveyorService:Init(services)
	Services = services
	MapBuilder = services.MapBuilder
	notify = Remotes.Get("Notify")
	announce = Remotes.Get("Announce")
	folder = Instance.new("Folder")
	folder.Name = "ConveyorPlushies"
	folder.Parent = workspace
end

function ConveyorService:GetLuck(): number
	local luckUntil = ReplicatedStorage:GetAttribute("ServerLuckUntil") or 0
	if luckUntil > workspace:GetServerTimeNow() then
		return Config.ServerLuck.Multiplier
	end
	return 1
end

function ConveyorService:SpawnPlushie(id: string?, mutation: string?)
	if not id then
		id, mutation = Plushies.RollPlushie(rng, self:GetLuck())
	end
	local def = Plushies.Get(id :: string)
	local startX = MapBuilder.LANE_START_X + 4
	local position = Vector3.new(startX, MapBuilder.LANE_TOP, 0)
	local ground = CFrame.lookAt(position, position + Vector3.xAxis)
	local model = PlushieFactory.Build(def.Id, mutation, "Conveyor", ground)
	if not model then
		return
	end
	local root = model.PrimaryPart :: BasePart
	local price = Plushies.GetPrice(def.Id, mutation)
	local item = { Model = model, Root = root, Id = def.Id, Mutation = mutation or "None", Price = price, Sold = false }

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Buy " .. Format.Cash(price)
	prompt.ObjectText = Plushies.DisplayName(def.Id, mutation)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(player)
		self:TryBuy(player, item)
	end)

	model.Parent = folder
	root:SetNetworkOwner(nil)
	table.insert(items, item)

	local isRainbow = item.Mutation == "Rainbow"
	if Config.Conveyor.AnnounceRarities[def.Rarity] or isRainbow then
		local rarity = Plushies.GetRarity(def.Rarity)
		announce:FireAllClients(
			`A {def.Rarity:upper()} {Plushies.DisplayName(def.Id, mutation)} is on the conveyor!`,
			rarity.Color
		)
	end
end

function ConveyorService:TryBuy(player: Player, item)
	if item.Sold or not item.Model then
		return
	end
	local baseService = Services.BaseService
	if not baseService:GetBase(player) then
		return
	end
	if not baseService:FindFreeSlot(player) then
		notify:FireClient(player, "Your base is full! Sell a plushie (hold F) or rebirth.", "error")
		return
	end
	if not Services.EconomyService:TrySpend(player, item.Price) then
		notify:FireClient(player, `You need {Format.Cash(item.Price)}!`, "error")
		return
	end
	item.Sold = true
	removeItem(item)
	baseService:AddPlushie(player, item.Id, item.Mutation)
	local name = Plushies.DisplayName(item.Id, item.Mutation)
	notify:FireClient(player, `You bought {name}! It's in your base.`, "success")
	local def = Plushies.Get(item.Id)
	if Config.Conveyor.AnnounceRarities[def.Rarity] then
		announce:FireAllClients(`{player.DisplayName} bought the {name}! Go steal it!`, Plushies.GetRarity(def.Rarity).Color)
	end
end

function ConveyorService:Start()
	task.spawn(function()
		while true do
			task.wait(Config.Conveyor.SpawnInterval)
			if #items < Config.Conveyor.MaxItems and #Players:GetPlayers() > 0 then
				local ok, err = pcall(self.SpawnPlushie, self)
				if not ok then
					warn("[ConveyorService] spawn failed:", err)
				end
			end
		end
	end)

	local speed = Config.Conveyor.Speed
	RunService.Heartbeat:Connect(function()
		for index = #items, 1, -1 do
			local item = items[index]
			local root = item.Root
			if not root or not root.Parent then
				removeItem(item)
				continue
			end
			local position = root.Position
			if position.X > MapBuilder.LANE_END_X or position.Y < -20 then
				removeItem(item)
				continue
			end
			-- Drive the plushie directly so it never stalls, tips over or drifts.
			if root.CFrame.UpVector.Y < 0.95 or math.abs(position.Z) > 3 then
				root.CFrame = CFrame.lookAt(Vector3.new(position.X, position.Y + 0.2, 0), Vector3.new(position.X + 1, position.Y + 0.2, 0))
			end
			root.AssemblyLinearVelocity = Vector3.new(speed, math.min(root.AssemblyLinearVelocity.Y, 0), 0)
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

return ConveyorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	Player save data with session locking, retries, autosave and safe shutdown.
	Only this module talks to the player DataStore.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local AUTOSAVE_INTERVAL = 90
local SESSION_LOCK_TIMEOUT = 30 * 60
local LOAD_ATTEMPTS = 6
local MAX_RECEIPTS = 50

local DataService = {}

local profiles: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}
local saving: { [Player]: boolean } = {}

local store: DataStore? = nil

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in value do
		copy[key] = deepCopy(inner)
	end
	return copy
end

local function template()
	return {
		Cash = Config.StartingCash,
		Uncollected = 0,
		Rebirths = 0,
		TotalEarned = 0,
		Steals = 0,
		Plushies = {
			{ Id = Config.StartingPlushie, Mutation = "None", Slot = 1 },
		},
		LastOnline = 0,
		DailyStreak = 0,
		LastDailyDay = 0,
		ShieldUntil = 0,
		Receipts = {},
	}
end

-- Adds any keys that were introduced after a player's data was first created.
local function reconcile(data, defaults)
	for key, value in defaults do
		if data[key] == nil then
			data[key] = deepCopy(value)
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

function DataService:Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable:", result)
	end
end

function DataService:Start()
	while true do
		task.wait(AUTOSAVE_INTERVAL)
		for player in profiles do
			task.spawn(self.Save, self, player, false)
		end
	end
end

function DataService:Get(player: Player)
	return profiles[player]
end

function DataService:Load(player: Player)
	local loaded = nil
	local saveAllowed = false

	if store then
		for attempt = 1, LOAD_ATTEMPTS do
			local lockedElsewhere = false
			local isLastAttempt = attempt == LOAD_ATTEMPTS
			local ok, result = pcall(function()
				return (store :: DataStore):UpdateAsync(keyFor(player), function(old)
					lockedElsewhere = false
					old = old or template()
					local lock = old.SessionLock
					if
						lock
						and lock.JobId ~= game.JobId
						and os.time() - (lock.Time or 0) < SESSION_LOCK_TIMEOUT
						and not isLastAttempt
					then
						-- Another server is still saving this player; wait for it.
						lockedElsewhere = true
						return nil
					end
					old.SessionLock = { JobId = game.JobId, Time = os.time() }
					return old
				end)
			end)
			if ok and result and not lockedElsewhere then
				loaded = result
				saveAllowed = true
				break
			end
			if not ok then
				warn(`[DataService] Load attempt {attempt} failed for {player.Name}: {result}`)
				if RunService:IsStudio() and string.find(tostring(result), "API", 1, true) then
					-- Studio without "Enable Studio Access to API Services": play without saving.
					break
				end
			end
			if not player.Parent then
				return nil
			end
			task.wait(3)
		end
	end

	if not player.Parent then
		if loaded and saveAllowed then
			-- They left while loading: hand the session lock straight back.
			profiles[player] = loaded
			canSave[player] = true
			self:Release(player)
		end
		return nil
	end

	if not loaded then
		if RunService:IsStudio() then
			warn("[DataService] Using temporary data (not saved). Enable Studio API access to test saving.")
			loaded = template()
		else
			player:Kick("We couldn't load your data. Please rejoin in a minute - your progress is safe.")
			return nil
		end
	end

	loaded.SessionLock = nil
	reconcile(loaded, template())
	profiles[player] = loaded
	canSave[player] = saveAllowed
	return loaded
end

function DataService:Save(player: Player, release: boolean): boolean
	local data = profiles[player]
	if not data or not store or not canSave[player] then
		return false
	end
	while saving[player] do
		task.wait(0.1)
	end
	saving[player] = true
	data.LastOnline = os.time()
	local snapshot = deepCopy(data)
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			if old and old.SessionLock and old.SessionLock.JobId ~= game.JobId then
				-- Another server took over this session; never overwrite its data.
				return nil
			end
			snapshot.SessionLock = if release then nil else { JobId = game.JobId, Time = os.time() }
			return snapshot
		end)
	end)
	saving[player] = nil
	if not ok then
		warn(`[DataService] Save failed for {player.Name}: {err}`)
	end
	return ok
end

function DataService:Release(player: Player)
	if profiles[player] then
		self:Save(player, true)
	end
	profiles[player] = nil
	canSave[player] = nil
end

function DataService:SaveAll()
	local pending = 0
	for player in profiles do
		pending += 1
		task.spawn(function()
			self:Save(player, true)
			pending -= 1
		end)
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 25 do
		task.wait(0.1)
	end
end

-- Receipt bookkeeping so a developer product is never granted twice.
function DataService:HasReceipt(player: Player, receiptId: string): boolean
	local data = profiles[player]
	return data ~= nil and table.find(data.Receipts, receiptId) ~= nil
end

function DataService:AddReceipt(player: Player, receiptId: string)
	local data = profiles[player]
	if not data then
		return
	end
	table.insert(data.Receipts, receiptId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
end

function DataService:CanSave(player: Player): boolean
	return canSave[player] == true
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	Cash, income, multipliers, collecting and rebirths.
	Every cash change goes through here so the HUD always stays in sync.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Plushies = require(ReplicatedStorage.Shared.Plushies)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local EconomyService = {}

local Services
local DataService
local notify: RemoteEvent
local announce: RemoteEvent
local lastRebirthRequest: { [Player]: number } = {}

function EconomyService:Init(services)
	Services = services
	DataService = services.DataService
	notify = Remotes.Get("Notify")
	announce = Remotes.Get("Announce")

	Remotes.Get("RequestRebirth").OnServerEvent:Connect(function(player)
		local last = lastRebirthRequest[player]
		if last and os.clock() - last < 1 then
			return
		end
		lastRebirthRequest[player] = os.clock()
		self:Rebirth(player)
	end)
end

function EconomyService:Start()
	while true do
		task.wait(1)
		for _, player in Players:GetPlayers() do
			local data = DataService:Get(player)
			if not data then
				continue
			end
			local income = self:GetIncome(player)
			if income > 0 then
				if Services.MonetizationService:HasPass(player, "AutoCollect") then
					data.Cash += income
				else
					data.Uncollected += income
				end
				data.TotalEarned += income
			end
			self:RefreshStats(player)
		end
	end
end

function EconomyService:GetMultiplier(player: Player): number
	local data = DataService:Get(player)
	if not data then
		return 1
	end
	local economy = Config.Economy
	local multiplier = 1 + data.Rebirths * economy.RebirthMultiplierBonus
	if Services.MonetizationService:HasPass(player, "DoubleCash") then
		multiplier *= economy.DoubleCashMultiplier
	end
	if Services.MonetizationService:HasPass(player, "VIP") then
		multiplier *= economy.VIPMultiplier
	end
	if player.MembershipType == Enum.MembershipType.Premium then
		multiplier *= economy.PremiumMultiplier
	end
	if player:GetAttribute("InGroup") then
		multiplier *= economy.GroupMultiplier
	end
	multiplier *= 1 + ((player:GetAttribute("FriendBonus") or 0) :: number)
	return multiplier
end

function EconomyService:GetBaseIncome(player: Player): number
	local total = 0
	for _, entry in Services.BaseService:GetActiveEntries(player) do
		total += Plushies.GetIncome(entry.Id, entry.Mutation)
	end
	return total
end

function EconomyService:GetIncome(player: Player): number
	return self:GetBaseIncome(player) * self:GetMultiplier(player)
end

function EconomyService:AddCash(player: Player, amount: number)
	local data = DataService:Get(player)
	if not data or amount <= 0 or amount ~= amount then
		return
	end
	data.Cash += amount
	data.TotalEarned += amount
	self:RefreshStats(player)
end

function EconomyService:TrySpend(player: Player, amount: number): boolean
	local data = DataService:Get(player)
	if not data or amount < 0 or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	self:RefreshStats(player)
	return true
end

function EconomyService:Collect(player: Player)
	local data = DataService:Get(player)
	if not data or data.Uncollected < 1 then
		return
	end
	local amount = data.Uncollected
	data.Uncollected = 0
	data.Cash += amount
	self:RefreshStats(player)
	notify:FireClient(player, "+" .. Format.Cash(amount), "cash")
end

function EconomyService:Rebirth(player: Player)
	local data = DataService:Get(player)
	if not data then
		return
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		notify:FireClient(player, `You need {Format.Cash(cost)} to rebirth.`, "error")
		return
	end
	Services.StealService:CancelAllFor(player)
	data.Rebirths += 1
	data.Cash = Config.StartingCash
	data.Uncollected = 0
	data.Plushies = { { Id = Config.StartingPlushie, Mutation = "None", Slot = 1 } }
	Services.BaseService:RenderAll(player)
	self:RefreshStats(player)
	local multiplier = 1 + data.Rebirths * Config.Economy.RebirthMultiplierBonus
	notify:FireClient(player, `Rebirth {data.Rebirths}! Permanent x{multiplier} cash and +1 slot.`, "success")
	announce:FireAllClients(`{player.DisplayName} just reached Rebirth {data.Rebirths}!`, Color3.fromRGB(255, 220, 80))
end

function EconomyService:RefreshStats(player: Player)
	local data = DataService:Get(player)
	if not data then
		return
	end
	local baseService = Services.BaseService
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Uncollected", data.Uncollected)
	player:SetAttribute("Income", self:GetIncome(player))
	player:SetAttribute("Multiplier", self:GetMultiplier(player))
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("RebirthCost", Config.RebirthCost(data.Rebirths))
	player:SetAttribute("SlotCount", baseService:GetSlotCount(player))
	player:SetAttribute("PlushieCount", #baseService:GetActiveEntries(player))
	player:SetAttribute("ShieldUntil", data.ShieldUntil or 0)

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		(leaderstats:FindFirstChild("Cash") :: StringValue).Value = Format.Cash(data.Cash);
		(leaderstats:FindFirstChild("Rebirths") :: IntValue).Value = data.Rebirths;
		(leaderstats:FindFirstChild("Steals") :: IntValue).Value = data.Steals
	end
end

function EconomyService:OnPlayerLoaded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	local steals = Instance.new("IntValue")
	steals.Name = "Steals"
	steals.Parent = leaderstats
	leaderstats.Parent = player
	self:RefreshStats(player)
end

function EconomyService:OnPlayerRemoving(player: Player)
	lastRebirthRequest[player] = nil
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Global "Richest Players" board (all-time cash earned), shown in the middle of the map.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)

local UPDATE_INTERVAL = 120
local MAX_SAFE_INTEGER = 2 ^ 53

local LeaderboardService = {}

local Services
local store: OrderedDataStore? = nil
local names: { [number]: string } = {}

local function nameFor(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	names[userId] = if ok then name else "Player"
	return names[userId]
end

function LeaderboardService:Init(services)
	Services = services
	local ok, result = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Config.LeaderboardStoreName)
	if ok then
		store = result
	end
end

function LeaderboardService:_render(entries)
	local list = Services.MapBuilder.LeaderboardList
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for rank, entry in entries do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = rank
		label.Size = UDim2.fromScale(1, 0.1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = if rank == 1
			then Color3.fromRGB(255, 215, 60)
			elseif rank == 2 then Color3.fromRGB(220, 220, 230)
			elseif rank == 3 then Color3.fromRGB(230, 150, 90)
			else Color3.new(1, 1, 1)
		label.Text = `#{rank}  {entry.Name}  -  {Format.Cash(entry.Value)}`
		label.Parent = list
	end
end

function LeaderboardService:_update()
	if not store then
		return
	end
	for _, player in Players:GetPlayers() do
		local data = Services.DataService:Get(player)
		if data and Services.DataService:CanSave(player) then
			local value = math.clamp(math.floor(data.TotalEarned), 0, MAX_SAFE_INTEGER)
			pcall((store :: OrderedDataStore).SetAsync, store, tostring(player.UserId), value)
		end
	end
	local ok, pages = pcall((store :: OrderedDataStore).GetSortedAsync, store, false, 10)
	if not ok then
		return
	end
	local entries = {}
	for _, item in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, { Name = nameFor(userId), Value = item.value })
		end
	end
	self:_render(entries)
end

function LeaderboardService:Start()
	task.wait(15)
	while true do
		local ok, err = pcall(self._update, self)
		if not ok then
			warn("[LeaderboardService]", err)
		end
		task.wait(UPDATE_INTERVAL)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--[[
	Builds the whole map from code: ground, the plushie conveyor lane, 8 player
	bases, and the leaderboard. Everything is generated at runtime so the game
	works straight from the repository. You can decorate around it freely in
	Studio; just keep new parts out of the base and lane areas.
]]

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

MapBuilder.BASE_WIDTH = 44
MapBuilder.BASE_DEPTH = 52
MapBuilder.WALL_HEIGHT = 14
MapBuilder.SLOT_COLUMNS = 4
MapBuilder.MAX_SLOTS = 20
MapBuilder.LANE_START_X = -165
MapBuilder.LANE_END_X = 165
MapBuilder.LANE_WIDTH = 12
MapBuilder.LANE_TOP = 0.5

MapBuilder.Bases = {}
MapBuilder.LeaderboardList = nil :: Frame?

local BASE_COLORS = {
	Color3.fromRGB(255, 120, 150),
	Color3.fromRGB(120, 180, 255),
	Color3.fromRGB(140, 220, 120),
	Color3.fromRGB(255, 200, 90),
	Color3.fromRGB(190, 130, 255),
	Color3.fromRGB(90, 220, 210),
	Color3.fromRGB(255, 150, 80),
	Color3.fromRGB(240, 240, 120),
}

local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

local function makeSurfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = gui
	return label
end

local function makeBillboard(part: BasePart, size: UDim2, offset: Vector3, maxDistance: number): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffsetWorldSpace = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	return gui, label
end

local function setupCollisionGroups()
	local groups = { "Players", "Plushies", "PlushieRails" }
	for index = 1, Config.Base.Count do
		table.insert(groups, "Barrier" .. index)
		table.insert(groups, "Owner" .. index)
	end
	for _, name in groups do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	-- Plushies on the conveyor never get pushed around by players.
	PhysicsService:CollisionGroupSetCollidable("Plushies", "Players", false)
	-- Invisible rails keep plushies on the lane but never block players.
	PhysicsService:CollisionGroupSetCollidable("PlushieRails", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("PlushieRails", "Players", false)
	for index = 1, Config.Base.Count do
		local owner = "Owner" .. index
		PhysicsService:CollisionGroupSetCollidable("Plushies", owner, false)
		PhysicsService:CollisionGroupSetCollidable("PlushieRails", owner, false)
		-- A base's laser barrier blocks everyone except that base's owner.
		PhysicsService:CollisionGroupSetCollidable("Barrier" .. index, owner, false)
		PhysicsService:CollisionGroupSetCollidable("Barrier" .. index, "Plushies", false)
	end
end

local function buildGround(map: Folder)
	makePart({
		Name = "Ground",
		Size = Vector3.new(420, 1, 240),
		Position = Vector3.new(0, -0.5, 0),
		Color = Color3.fromRGB(110, 190, 95),
		Material = Enum.Material.Grass,
		Parent = map,
	})

	local laneLength = MapBuilder.LANE_END_X - MapBuilder.LANE_START_X
	local laneCenterX = (MapBuilder.LANE_END_X + MapBuilder.LANE_START_X) / 2
	makePart({
		Name = "Conveyor",
		Size = Vector3.new(laneLength, 1, MapBuilder.LANE_WIDTH),
		Position = Vector3.new(laneCenterX, 0, 0),
		Color = Color3.fromRGB(55, 55, 70),
		Material = Enum.Material.DiamondPlate,
		Parent = map,
	})
	for _, side in { -1, 1 } do
		makePart({
			Name = "LaneStripe",
			Size = Vector3.new(laneLength, 0.2, 0.5),
			Position = Vector3.new(laneCenterX, 0.6, side * (MapBuilder.LANE_WIDTH / 2 - 0.25)),
			Color = Color3.fromRGB(255, 220, 80),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = map,
		})
		makePart({
			Name = "PlushieRail",
			Size = Vector3.new(laneLength, 4, 1),
			Position = Vector3.new(laneCenterX, 2.5, side * (MapBuilder.LANE_WIDTH / 2 + 0.5)),
			Transparency = 1,
			CanQuery = false,
			CanTouch = false,
			CollisionGroup = "PlushieRails",
			Parent = map,
		})
	end
	-- Direction arrows along the lane.
	for x = MapBuilder.LANE_START_X + 20, MapBuilder.LANE_END_X - 20, 30 do
		local arrow = makePart({
			Name = "Arrow",
			Size = Vector3.new(4, 0.1, 3),
			CFrame = CFrame.new(x, 0.55, 0) * CFrame.Angles(0, math.rad(-90), 0),
			Color = Color3.fromRGB(85, 85, 105),
			CanCollide = false,
			Parent = map,
		})
		makeSurfaceText(arrow, Enum.NormalId.Top, "▲", Color3.fromRGB(255, 220, 80))
	end

	-- Factory arch where plushies come out, and the drain at the other end.
	for _, info in { { MapBuilder.LANE_START_X, "PLUSHIE FACTORY", Color3.fromRGB(255, 120, 170) }, { MapBuilder.LANE_END_X, "LAST CHANCE!", Color3.fromRGB(120, 120, 140) } } do
		local x, text, color = info[1], info[2], info[3]
		for _, side in { -1, 1 } do
			makePart({
				Name = "ArchPillar",
				Size = Vector3.new(3, 14, 3),
				Position = Vector3.new(x, 7, side * 8),
				Color = color,
				Parent = map,
			})
		end
		local top = makePart({
			Name = "ArchTop",
			Size = Vector3.new(3, 4, 19),
			Position = Vector3.new(x, 15, 0),
			Color = color,
			Parent = map,
		})
		makeSurfaceText(top, Enum.NormalId.Right, text)
		makeSurfaceText(top, Enum.NormalId.Left, text)
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Vector3.new(MapBuilder.LANE_START_X + 20, 0, -14)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(255, 255, 255)
	spawn.Parent = map
end

local function buildLeaderboard(map: Folder)
	local position = Vector3.new(0, 9, 40)
	local board = makePart({
		Name = "Leaderboard",
		Size = Vector3.new(16, 14, 1),
		CFrame = CFrame.lookAt(position, position + Vector3.new(0, 0, -1)),
		Color = Color3.fromRGB(40, 40, 60),
		Parent = map,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = board

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.14)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 220, 80)
	title.Text = "🏆 RICHEST PLAYERS"
	title.Parent = gui

	local list = Instance.new("Frame")
	list.Name = "List"
	list.Position = UDim2.fromScale(0.05, 0.16)
	list.Size = UDim2.fromScale(0.9, 0.82)
	list.BackgroundTransparency = 1
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for _, side in { -1, 1 } do
		makePart({
			Name = "BoardLeg",
			Size = Vector3.new(1, 3, 1),
			Position = Vector3.new(side * 6, 1, 40),
			Color = Color3.fromRGB(40, 40, 60),
			Parent = map,
		})
	end
	MapBuilder.LeaderboardList = list
end

local function buildBase(map: Folder, index: number, origin: CFrame)
	local width, depth, height = MapBuilder.BASE_WIDTH, MapBuilder.BASE_DEPTH, MapBuilder.WALL_HEIGHT
	local color = BASE_COLORS[(index - 1) % #BASE_COLORS + 1]
	local folder = Instance.new("Folder")
	folder.Name = "Base" .. index
	folder.Parent = map

	-- Local helper: x = left/right, y = up, d = depth into the base from the entrance.
	local function at(x: number, y: number, d: number): CFrame
		return origin * CFrame.new(x, y, -d)
	end

	makePart({
		Name = "Floor",
		Size = Vector3.new(width, 1, depth),
		CFrame = at(0, 0, depth / 2),
		Color = color:Lerp(Color3.new(1, 1, 1), 0.65),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	for _, side in { -1, 1 } do
		makePart({
			Name = "SideWall",
			Size = Vector3.new(1, height, depth),
			CFrame = at(side * width / 2, height / 2 + 0.5, depth / 2),
			Color = color,
			Parent = folder,
		})
		makePart({
			Name = "Pillar",
			Size = Vector3.new(2.5, height + 3, 2.5),
			CFrame = at(side * width / 2, (height + 3) / 2, 0),
			Color = color:Lerp(Color3.new(0, 0, 0), 0.25),
			Parent = folder,
		})
	end
	makePart({
		Name = "BackWall",
		Size = Vector3.new(width, height, 1),
		CFrame = at(0, height / 2 + 0.5, depth),
		Color = color,
		Parent = folder,
	})

	local sign = makePart({
		Name = "Sign",
		Size = Vector3.new(width, 3, 1),
		CFrame = at(0, height + 2, 0),
		Color = color:Lerp(Color3.new(0, 0, 0), 0.25),
		CanCollide = false,
		Parent = folder,
	})
	local signOutside = makeSurfaceText(sign, Enum.NormalId.Back, "Empty Base")
	local signInside = makeSurfaceText(sign, Enum.NormalId.Front, "Empty Base")

	local barrier = makePart({
		Name = "Barrier",
		Size = Vector3.new(width, height, 0.6),
		CFrame = at(0, height / 2 + 0.5, 0),
		Color = Color3.fromRGB(255, 50, 70),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CollisionGroup = "Barrier" .. index,
		Parent = folder,
	})

	local pedestals = {}
	for slot = 1, MapBuilder.MAX_SLOTS do
		local row = math.ceil(slot / MapBuilder.SLOT_COLUMNS)
		local column = (slot - 1) % MapBuilder.SLOT_COLUMNS + 1
		local x = -13.5 + (column - 1) * 9
		local d = 16 + (row - 1) * 7
		local pedestal = makePart({
			Name = "Pedestal" .. slot,
			Size = Vector3.new(6, 1, 5),
			CFrame = at(x, 1, d),
			Color = Color3.fromRGB(245, 245, 250),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		pedestal:SetAttribute("Slot", slot)
		local lockGui, lockLabel = makeBillboard(pedestal, UDim2.fromOffset(120, 40), Vector3.new(0, 2.5, 0), 50)
		lockGui.Name = "LockedLabel"
		lockLabel.Text = "🔒 Rebirth"
		lockLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
		lockGui.Enabled = false
		pedestals[slot] = {
			Part = pedestal,
			-- Plushies stand on top of the pedestal and face the entrance.
			StandCFrame = at(x, 1.5, d) * CFrame.Angles(0, math.pi, 0),
			LockedGui = lockGui,
		}
	end

	local collectPad = makePart({
		Name = "CollectPad",
		Size = Vector3.new(8, 0.4, 6),
		CFrame = at(-14, 0.7, 6),
		Color = Color3.fromRGB(80, 230, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	local _, collectLabel = makeBillboard(collectPad, UDim2.fromOffset(200, 70), Vector3.new(0, 4, 0), 80)
	collectLabel.Text = "COLLECT\n$0"
	collectLabel.TextColor3 = Color3.fromRGB(140, 255, 160)

	local lockPad = makePart({
		Name = "LockPad",
		Size = Vector3.new(8, 0.4, 6),
		CFrame = at(14, 0.7, 6),
		Color = Color3.fromRGB(255, 80, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	local _, lockLabel = makeBillboard(lockPad, UDim2.fromOffset(200, 70), Vector3.new(0, 4, 0), 80)
	lockLabel.Text = "🔒 LOCK BASE"

	MapBuilder.Bases[index] = {
		Index = index,
		Origin = origin,
		Folder = folder,
		Barrier = barrier,
		SignLabels = { signOutside, signInside },
		Pedestals = pedestals,
		CollectPad = collectPad,
		CollectLabel = collectLabel,
		LockPad = lockPad,
		LockLabel = lockLabel,
		SpawnCFrame = at(0, 4, 9) * CFrame.Angles(0, math.pi, 0),
		OutsideCFrame = at(0, 4, -8) * CFrame.Angles(0, math.pi, 0),
	}
end

function MapBuilder:Init()
	setupCollisionGroups()

	local existing = workspace:FindFirstChild("Map")
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace

	buildGround(map)
	buildLeaderboard(map)

	local perSide = math.ceil(Config.Base.Count / 2)
	local spacing = 64
	local laneGap = MapBuilder.LANE_WIDTH / 2 + 12
	for index = 1, Config.Base.Count do
		local north = index <= perSide
		local column = if north then index else index - perSide
		local x = (column - (perSide + 1) / 2) * spacing
		local z = if north then laneGap else -laneGap
		local direction = if north then 1 else -1
		local position = Vector3.new(x, 0, z)
		buildBase(map, index, CFrame.lookAt(position, position + Vector3.new(0, 0, direction)))
	end
end

-- Returns the position relative to a base: x (sideways), depth (into base), y.
function MapBuilder:ToBaseSpace(base, position: Vector3): (number, number, number)
	local relative = base.Origin:PointToObjectSpace(position)
	return relative.X, -relative.Z, relative.Y
end

function MapBuilder:IsInsideBase(base, position: Vector3): boolean
	local x, depth, y = self:ToBaseSpace(base, position)
	return math.abs(x) <= self.BASE_WIDTH / 2 and depth >= 0.5 and depth <= self.BASE_DEPTH and y > -4 and y < 30
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--[[
	Game passes, developer products and Premium benefits.

	Developer products are granted inside ProcessReceipt and recorded per player,
	so a purchase is never lost and never granted twice.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Plushies = require(ReplicatedStorage.Shared.Plushies)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local MonetizationService = {}

local Services
local DataService
local notify: RemoteEvent
local announce: RemoteEvent
local rng = Random.new()

local owned: { [Player]: { [string]: boolean } } = {}
local passById: { [number]: any } = {}
local productById: { [number]: any } = {}
local lastRequest: { [Player]: number } = {}

local MYSTERY_BOX_ODDS = { Epic = 70, Legendary = 25, Mythic = 4.5, Secret = 0.5 }

function MonetizationService:Init(services)
	Services = services
	DataService = services.DataService
	notify = Remotes.Get("Notify")
	announce = Remotes.Get("Announce")

	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			passById[pass.Id] = pass
		end
	end
	for _, product in Config.Products do
		if product.Id ~= 0 then
			productById[product.Id] = product
		end
	end

	Remotes.Get("RequestPurchase").OnServerEvent:Connect(function(player, kind, key)
		if type(kind) ~= "string" or type(key) ~= "string" then
			return
		end
		local last = lastRequest[player]
		if last and os.clock() - last < 0.5 then
			return
		end
		lastRequest[player] = os.clock()
		self:_handlePurchaseRequest(player, kind, key)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local pass = passById[passId]
		if purchased and pass then
			self:GrantPass(player, pass.Key)
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		return self:_processReceipt(receipt)
	end

	Players.PlayerMembershipChanged:Connect(function(player)
		Services.EconomyService:RefreshStats(player)
	end)
end

function MonetizationService:_handlePurchaseRequest(player: Player, kind: string, key: string)
	if kind == "Pass" then
		local pass = Config.GetPass(key)
		if not pass then
			return
		end
		if self:HasPass(player, key) then
			notify:FireClient(player, `You already own {pass.Name}!`, "info")
		elseif pass.Id ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		elseif RunService:IsStudio() then
			self:GrantPass(player, key)
			notify:FireClient(player, "(Studio test) Pass granted for this session.", "info")
		else
			notify:FireClient(player, "This item isn't available yet - check back soon!", "error")
		end
	elseif kind == "Product" then
		local product = Config.GetProduct(key)
		if not product then
			return
		end
		if product.Id ~= 0 then
			MarketplaceService:PromptProductPurchase(player, product.Id)
		elseif RunService:IsStudio() then
			self:GrantProduct(player, product)
			notify:FireClient(player, "(Studio test) Product granted for free.", "info")
		else
			notify:FireClient(player, "This item isn't available yet - check back soon!", "error")
		end
	end
end

function MonetizationService:_processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local product = productById[receipt.ProductId]
	if not player or not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Data can still be loading if they bought something right after joining.
	local waited = 0
	while not DataService:Get(player) and player.Parent and waited < 15 do
		waited += task.wait(0.5)
	end
	if not DataService:Get(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receiptId = tostring(receipt.PurchaseId)
	if DataService:HasReceipt(player, receiptId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local ok, err = pcall(self.GrantProduct, self, player, product)
	if not ok then
		warn("[MonetizationService] Failed to grant", product.Key, err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService:AddReceipt(player, receiptId)
	if DataService:CanSave(player) and not DataService:Save(player, false) then
		-- Recorded in memory, so a retry in this server will not grant it twice.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService:HasPass(player: Player, key: string): boolean
	local passes = owned[player]
	return passes ~= nil and passes[key] == true
end

function MonetizationService:GetWalkSpeed(player: Player): number
	if self:HasPass(player, "Speed") then
		return Config.Movement.SpeedPassWalkSpeed
	end
	return Config.Movement.WalkSpeed
end

function MonetizationService:_applyWalkSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and not Services.StealService:IsCarrying(player) then
		humanoid.WalkSpeed = self:GetWalkSpeed(player)
	end
end

function MonetizationService:GrantPass(player: Player, key: string)
	owned[player] = owned[player] or {}
	if owned[player][key] then
		return
	end
	owned[player][key] = true
	player:SetAttribute("Pass_" .. key, true)
	if key == "Speed" then
		self:_applyWalkSpeed(player)
	elseif key == "ExtraSlots" then
		Services.BaseService:RenderAll(player)
	end
	Services.EconomyService:RefreshStats(player)
	local pass = Config.GetPass(key)
	if pass then
		notify:FireClient(player, `Thanks for buying {pass.Name}! 💖`, "success")
	end
end

function MonetizationService:GiveMysteryBox(player: Player, source: string)
	local id, mutation = Plushies.RollPlushie(rng, 1, MYSTERY_BOX_ODDS)
	local name = Plushies.DisplayName(id, mutation)
	local def = Plushies.Get(id)
	if Services.BaseService:AddPlushie(player, id, mutation) then
		notify:FireClient(player, `{source}: you got {def.Rarity} {name}! 🎁`, "success")
	else
		local value = Plushies.GetPrice(id, mutation)
		Services.EconomyService:AddCash(player, value)
		notify:FireClient(player, `{source}: {name}! Your base was full, so you got {Format.Cash(value)} instead.`, "success")
	end
	if Config.Conveyor.AnnounceRarities[def.Rarity] then
		announce:FireAllClients(`{player.DisplayName} unboxed a {def.Rarity:upper()} {name}!`, Plushies.GetRarity(def.Rarity).Color)
	end
end

function MonetizationService:GrantProduct(player: Player, product)
	local data = DataService:Get(player)
	if not data then
		error("player data not loaded")
	end
	if product.Kind == "Cash" then
		local amount = math.max(product.Floor, Services.EconomyService:GetIncome(player) * product.Seconds)
		Services.EconomyService:AddCash(player, amount)
		notify:FireClient(player, `+{Format.Cash(amount)}! Thanks for your support 💖`, "cash")
	elseif product.Kind == "ServerLuck" then
		local now = workspace:GetServerTimeNow()
		local current = ReplicatedStorage:GetAttribute("ServerLuckUntil") or 0
		ReplicatedStorage:SetAttribute("ServerLuckUntil", math.max(now, current) + Config.ServerLuck.Duration)
		ReplicatedStorage:SetAttribute("ServerLuckBy", player.DisplayName)
		announce:FireAllClients(`🍀 {player.DisplayName} activated 2x SERVER LUCK for everyone!`, Color3.fromRGB(90, 255, 120))
	elseif product.Kind == "Shield" then
		data.ShieldUntil = math.max(os.time(), data.ShieldUntil or 0) + Config.Shield.Duration
		Services.EconomyService:RefreshStats(player)
		notify:FireClient(player, "🛡️ Steal Shield active for 30 minutes!", "success")
	elseif product.Kind == "MysteryBox" then
		self:GiveMysteryBox(player, "Mystery Box")
	else
		error("unknown product kind " .. tostring(product.Kind))
	end
end

function MonetizationService:OnPlayerLoaded(player: Player)
	owned[player] = owned[player] or {}
	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and result then
				owned[player][pass.Key] = true
				player:SetAttribute("Pass_" .. pass.Key, true)
			end
		end
	end
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid", 5)
		self:_applyWalkSpeed(player)
	end)
	self:_applyWalkSpeed(player)
end

function MonetizationService:OnPlayerRemoving(player: Player)
	owned[player] = nil
	lastRequest[player] = nil
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">PlushieFactory</string>
            <string name="Source"><![CDATA[--[[
	Builds plushie models. By default each plushie is assembled from simple parts
	(cute, readable, zero assets needed). Drop a Model named after a plushie's Id
	into ServerStorage > PlushieModels to replace it with a real 3D model.

	Every model has an invisible "Root" part at its feet; all other parts are
	welded to it, so moving or anchoring the Root moves the whole plushie.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local Plushies = require(ReplicatedStorage.Shared.Plushies)

local PlushieFactory = {}

export type Mode = "Static" | "Conveyor" | "Carry"

local function ball(size: number, color: Color3, material: Enum.Material, cframe: CFrame, parent: Instance): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(size, size, size)
	part.Color = color
	part.Material = material
	part.CFrame = cframe
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function block(size: Vector3, color: Color3, material: Enum.Material, cframe: CFrame, parent: Instance): Part
	local part = Instance.new("Part")
	part.Size = size
	part.Color = color
	part.Material = material
	part.CFrame = cframe
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildProcedural(def, mutation, model: Model, ground: CFrame): number
	local s = def.Scale or 1
	local mutationDef = Plushies.GetMutation(mutation)
	local color = if mutationDef then mutationDef.Color else def.Color
	local accent = def.Accent
	local material = if mutationDef then mutationDef.Material else (def.Material or Enum.Material.Fabric)
	local black = Color3.fromRGB(25, 25, 30)

	local bodyY = 0.4 + 1.2 * s
	local headY = bodyY + 1.1 * s + 0.75 * s
	local body = ball(2.4 * s, color, material, ground * CFrame.new(0, bodyY, 0), model)
	body.Name = "Body"
	local head = ball(1.9 * s, color, material, ground * CFrame.new(0, headY, 0), model)
	head.Name = "Head"
	local headCF = head.CFrame
	local bodyCF = body.CFrame

	-- Belly patch, eyes and blush give everything a plushie face.
	ball(1.4 * s, accent, Enum.Material.Fabric, bodyCF * CFrame.new(0, -0.1 * s, -0.55 * s), model)
	if def.Shape ~= "Frog" then
		for _, side in { -1, 1 } do
			ball(0.32 * s, black, Enum.Material.SmoothPlastic, headCF * CFrame.new(side * 0.35 * s, 0.12 * s, -0.82 * s), model)
			ball(0.28 * s, Color3.fromRGB(255, 150, 170), Enum.Material.Fabric, headCF * CFrame.new(side * 0.6 * s, -0.22 * s, -0.68 * s), model)
		end
	end

	local shape = def.Shape
	if shape == "Bear" or shape == "Unicorn" then
		for _, side in { -1, 1 } do
			ball(0.75 * s, color, material, headCF * CFrame.new(side * 0.7 * s, 0.75 * s, 0), model)
			ball(0.4 * s, accent, Enum.Material.Fabric, headCF * CFrame.new(side * 0.7 * s, 0.75 * s, -0.22 * s), model)
		end
	end
	if shape == "Unicorn" then
		block(Vector3.new(0.35, 1.3, 0.35) * s, accent, Enum.Material.Neon, headCF * CFrame.new(0, 1.15 * s, -0.35 * s) * CFrame.Angles(math.rad(-20), 0, 0), model)
	elseif shape == "Bunny" then
		for _, side in { -1, 1 } do
			block(Vector3.new(0.45, 1.7, 0.3) * s, color, material, headCF * CFrame.new(side * 0.42 * s, 1.5 * s, 0) * CFrame.Angles(0, 0, math.rad(side * -10)), model)
			block(Vector3.new(0.25, 1.3, 0.1) * s, accent, Enum.Material.Fabric, headCF * CFrame.new(side * 0.42 * s, 1.5 * s, -0.16 * s) * CFrame.Angles(0, 0, math.rad(side * -10)), model)
		end
	elseif shape == "Cat" then
		for _, side in { -1, 1 } do
			block(Vector3.new(0.65, 0.65, 0.25) * s, color, material, headCF * CFrame.new(side * 0.55 * s, 0.85 * s, 0) * CFrame.Angles(0, 0, math.rad(45)), model)
		end
		block(Vector3.new(0.3, 0.3, 1.6) * s, color, material, bodyCF * CFrame.new(0, 0.2 * s, 1.3 * s) * CFrame.Angles(math.rad(-35), 0, 0), model)
	elseif shape == "Frog" then
		for _, side in { -1, 1 } do
			ball(0.8 * s, color, material, headCF * CFrame.new(side * 0.5 * s, 0.75 * s, -0.25 * s), model)
			ball(0.4 * s, black, Enum.Material.SmoothPlastic, headCF * CFrame.new(side * 0.5 * s, 0.8 * s, -0.55 * s), model)
		end
		block(Vector3.new(0.9, 0.12, 0.1) * s, black, Enum.Material.SmoothPlastic, headCF * CFrame.new(0, -0.25 * s, -0.9 * s), model)
	elseif shape == "Bird" then
		block(Vector3.new(0.6, 0.3, 0.7) * s, Color3.fromRGB(255, 150, 40), Enum.Material.SmoothPlastic, headCF * CFrame.new(0, -0.15 * s, -0.95 * s), model)
		for _, side in { -1, 1 } do
			block(Vector3.new(0.3, 1.1, 1.3) * s, accent, material, bodyCF * CFrame.new(side * 1.15 * s, 0.1 * s, 0) * CFrame.Angles(0, 0, math.rad(side * 20)), model)
		end
		ball(0.5 * s, accent, material, headCF * CFrame.new(0, 0.95 * s, 0), model)
	elseif shape == "Fish" then
		block(Vector3.new(0.25, 1.2, 1.2) * s, accent, material, bodyCF * CFrame.new(0, 1.15 * s, 0.2 * s) * CFrame.Angles(math.rad(45), 0, 0), model)
		block(Vector3.new(0.25, 1.3, 1.3) * s, accent, material, bodyCF * CFrame.new(0, 0, 1.5 * s) * CFrame.Angles(math.rad(45), 0, 0), model)
		for _, side in { -1, 1 } do
			block(Vector3.new(0.6, 0.12, 0.25) * s, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, headCF * CFrame.new(side * 0.25 * s, -0.4 * s, -0.85 * s), model)
		end
	elseif shape == "Blob" then
		ball(0.55 * s, accent, Enum.Material.Fabric, headCF * CFrame.new(0, 0.95 * s, 0), model)
	end

	if def.Hat == "Crown" then
		local gold = Color3.fromRGB(255, 205, 50)
		block(Vector3.new(1.2, 0.35, 1.2) * s, gold, Enum.Material.Foil, headCF * CFrame.new(0, 1.0 * s, 0), model)
		for corner = 0, 3 do
			local angle = corner * math.pi / 2
			block(Vector3.new(0.25, 0.45, 0.25) * s, gold, Enum.Material.Foil, headCF * CFrame.new(math.cos(angle) * 0.45 * s, 1.35 * s, math.sin(angle) * 0.45 * s), model)
		end
	end

	return headY + 1.5 * s
end

local function buildCustom(template: Model, model: Model, ground: CFrame): number
	local clone = template:Clone()
	local _, size = clone:GetBoundingBox()
	clone:PivotTo(ground * CFrame.new(0, 0.4 + size.Y / 2, 0))
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Parent = model
		end
	end
	clone:Destroy()
	return 0.4 + size.Y
end

local function addBillboard(root: BasePart, def, mutation: string, height: number, compact: boolean)
	local rarity = Plushies.GetRarity(def.Rarity)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = if compact then UDim2.fromOffset(160, 36) else UDim2.fromOffset(200, 84)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height + 0.5, 0)
	gui.MaxDistance = if compact then 60 else 45
	gui.LightInfluence = 0
	gui.Parent = root

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = gui

	local function line(order: number, text: string, color: Color3, scale: number)
		local label = Instance.new("TextLabel")
		label.LayoutOrder = order
		label.Size = UDim2.new(1, 0, scale, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		label.TextStrokeTransparency = 0.1
		label.Text = text
		label.Parent = gui
		return label
	end

	local mutationDef = Plushies.GetMutation(mutation)
	if compact then
		line(1, Plushies.DisplayName(def.Id, mutation), rarity.Color, 1)
		return
	end
	if mutationDef then
		line(0, mutationDef.Name:upper(), mutationDef.Color, 0.2)
	end
	line(1, def.Name, Color3.new(1, 1, 1), 0.28)
	local rarityLabel = line(2, def.Rarity, rarity.Color, 0.2)
	if def.Rarity == "Secret" then
		rarityLabel.TextColor3 = Color3.new(1, 1, 1)
		rarityLabel.TextStrokeColor3 = Color3.fromRGB(170, 60, 255)
	end
	line(3, Format.Cash(Plushies.GetIncome(def.Id, mutation)) .. "/s", Color3.fromRGB(120, 255, 140), 0.2)
end

-- `ground` is where the plushie's feet go; the model faces ground's LookVector.
function PlushieFactory.Build(id: string, mutation: string?, mode: Mode, ground: CFrame): Model?
	local def = Plushies.Get(id)
	if not def then
		warn("[PlushieFactory] Unknown plushie", id)
		return nil
	end
	local mutationName: string = mutation or "None"

	local model = Instance.new("Model")
	model.Name = def.Id
	model:SetAttribute("PlushieId", def.Id)
	model:SetAttribute("Mutation", mutationName)
	model:SetAttribute("Rarity", def.Rarity)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = if mode == "Conveyor" then Vector3.new(2.8, 0.8, 2.8) else Vector3.new(2.6, 0.8, 2.6)
	root.CFrame = ground * CFrame.new(0, 0.4, 0)
	root.Transparency = 1
	root.CanCollide = mode == "Conveyor"
	root.CanTouch = false
	root.Anchored = mode == "Static"
	root.Parent = model
	model.PrimaryPart = root

	local customFolder = ServerStorage:FindFirstChild("PlushieModels")
	local custom = customFolder and customFolder:FindFirstChild(def.Id)
	local height
	if custom and custom:IsA("Model") then
		height = buildCustom(custom, model, ground)
	else
		height = buildProcedural(def, mutationName, model, ground)
	end

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= root then
			part.Anchored = false
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = mode ~= "Carry"
			part.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
	end

	if mode == "Conveyor" then
		root.CollisionGroup = "Plushies"
		root.CustomPhysicalProperties = PhysicalProperties.new(2, 0.05, 0, 1, 1)
	elseif mode == "Carry" then
		root.Massless = true
		root.CanQuery = false
	end

	if mutationName == "Rainbow" then
		CollectionService:AddTag(model, "Rainbow")
	end

	addBillboard(root, def, mutationName, height, mode == "Carry")
	return model
end

return PlushieFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">RewardsService</string>
            <string name="Source"><![CDATA[--[[
	Reasons to come back (and to bring friends):
	  * offline earnings while you're away
	  * a 7-day daily reward streak (day 7 = free Mystery Box)
	  * group member bonus and a bonus for every friend in your server
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local RewardsService = {}

local Services
local DataService
local notify: RemoteEvent
local friendCache: { [string]: boolean } = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

function RewardsService:Init(services)
	Services = services
	DataService = services.DataService
	notify = Remotes.Get("Notify")
	Remotes.Get("ClaimDaily").OnServerEvent:Connect(function(player)
		self:ClaimDaily(player)
	end)
end

function RewardsService:Start()
	while true do
		task.wait(30)
		for _, player in Players:GetPlayers() do
			self:_updateDaily(player)
		end
	end
end

function RewardsService:_dailyInfo(player: Player, data)
	local day = today()
	local canClaim = data.LastDailyDay < day
	local streak
	if canClaim then
		streak = if data.LastDailyDay == day - 1 then data.DailyStreak % 7 + 1 else 1
	else
		streak = data.DailyStreak
	end
	local income = Services.EconomyService:GetIncome(player)
	local reward = math.max(Config.Daily.BaseReward * streak, income * Config.Daily.IncomeSeconds * streak)
	return canClaim, streak, reward, day
end

function RewardsService:_updateDaily(player: Player)
	local data = DataService:Get(player)
	if not data then
		return
	end
	local canClaim, streak, reward, day = self:_dailyInfo(player, data)
	player:SetAttribute("DailyCanClaim", canClaim)
	player:SetAttribute("DailyStreak", streak)
	player:SetAttribute("DailyReward", reward)
	player:SetAttribute("DailyResetAt", (day + 1) * 86400)
end

function RewardsService:ClaimDaily(player: Player)
	local data = DataService:Get(player)
	if not data then
		return
	end
	local canClaim, streak, reward, day = self:_dailyInfo(player, data)
	if not canClaim then
		return
	end
	data.LastDailyDay = day
	data.DailyStreak = streak
	Services.EconomyService:AddCash(player, reward)
	notify:FireClient(player, `Day {streak} reward: +{Format.Cash(reward)}!`, "cash")
	if streak == Config.Daily.MysteryBoxDay then
		Services.MonetizationService:GiveMysteryBox(player, "Day 7 bonus")
	end
	self:_updateDaily(player)
end

function RewardsService:_grantOffline(player: Player, data)
	if data.LastOnline <= 0 then
		return
	end
	local hasPass = Services.MonetizationService:HasPass(player, "OfflineEarnings")
	local rate = if hasPass then Config.Offline.PassRate else Config.Offline.Rate
	local capHours = if hasPass then Config.Offline.PassCapHours else Config.Offline.CapHours
	local seconds = math.clamp(os.time() - data.LastOnline, 0, capHours * 3600)
	local amount = Services.EconomyService:GetIncome(player) * seconds * rate
	if amount >= 1 and seconds >= 60 then
		Services.EconomyService:AddCash(player, amount)
		player:SetAttribute("OfflineEarned", amount)
		player:SetAttribute("OfflineSeconds", seconds)
	end
end

local function areFriends(a: Player, b: Player): boolean
	local low, high = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = low .. "_" .. high
	if friendCache[key] == nil then
		local ok, result = pcall(a.IsFriendsWithAsync, a, b.UserId)
		friendCache[key] = ok and result == true
	end
	return friendCache[key]
end

function RewardsService:_refreshFriendBonuses(leaving: Player?)
	local players = Players:GetPlayers()
	for _, player in players do
		if player == leaving then
			continue
		end
		local friends = 0
		for _, other in players do
			if other ~= player and other ~= leaving and areFriends(player, other) then
				friends += 1
			end
		end
		local bonus = math.min(friends * Config.Economy.FriendBonusPer, Config.Economy.FriendBonusMax)
		player:SetAttribute("FriendBonus", bonus)
		player:SetAttribute("FriendsInServer", friends)
		Services.EconomyService:RefreshStats(player)
	end
end

function RewardsService:OnPlayerLoaded(player: Player, data)
	self:_grantOffline(player, data)
	self:_updateDaily(player)
	task.spawn(function()
		if Config.GroupId ~= 0 then
			local ok, inGroup = pcall(player.IsInGroupAsync, player, Config.GroupId)
			player:SetAttribute("InGroup", ok and inGroup == true)
		end
		self:_refreshFriendBonuses(nil)
	end)
end

function RewardsService:OnPlayerRemoving(player: Player)
	task.spawn(self._refreshFriendBonuses, self, player)
end

return RewardsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[--[[
	The heart of the game: grab a plushie from someone else's base, carry it over
	your head and run it back to your own base before you get bonked or the owner
	tags you.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Plushies = require(ReplicatedStorage.Shared.Plushies)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PlushieFactory = require(script.Parent.PlushieFactory)

local StealService = {}

local Services
local BaseService
local notify: RemoteEvent
local announce: RemoteEvent
local carriedFolder: Folder

type Carry = {
	Owner: Player,
	Slot: number,
	Entry: any,
	Model: Model,
	DiedConnection: RBXScriptConnection?,
}

local carries: { [Player]: Carry } = {}

local function aliveParts(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or humanoid.Health <= 0 or not root then
		return nil, nil
	end
	return humanoid, root
end

function StealService:Init(services)
	Services = services
	BaseService = services.BaseService
	notify = Remotes.Get("Notify")
	announce = Remotes.Get("Announce")
	carriedFolder = Instance.new("Folder")
	carriedFolder.Name = "CarriedPlushies"
	carriedFolder.Parent = workspace
end

function StealService:IsCarrying(player: Player): boolean
	return carries[player] ~= nil
end

function StealService:TryStart(thief: Player, owner: Player, slot: number)
	if thief == owner or carries[thief] or not owner.Parent then
		return
	end
	if not BaseService:GetBase(thief) then
		notify:FireClient(thief, "You need a base to steal!", "error")
		return
	end
	local base = BaseService:GetBase(owner)
	if not base or base.Stealing[slot] then
		return
	end
	local reason = BaseService:GetProtectionReason(owner)
	if reason then
		notify:FireClient(thief, reason, "error")
		return
	end
	local entry = BaseService:GetEntry(owner, slot)
	if not entry then
		return
	end
	if not BaseService:FindFreeSlot(thief) then
		notify:FireClient(thief, "Your base is full! Sell something first.", "error")
		return
	end
	local humanoid, root = aliveParts(thief)
	local head = thief.Character and thief.Character:FindFirstChild("Head") :: BasePart?
	if not humanoid or not root or not head then
		return
	end

	local ground = CFrame.new(head.Position + Vector3.new(0, head.Size.Y / 2 + 0.1, 0)) * root.CFrame.Rotation
	local model = PlushieFactory.Build(entry.Id, entry.Mutation, "Carry", ground)
	if not model then
		return
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
	model.Parent = carriedFolder

	base.Stealing[slot] = thief
	BaseService:RenderSlot(owner, slot)

	local carry: Carry = { Owner = owner, Slot = slot, Entry = entry, Model = model }
	carry.DiedConnection = humanoid.Died:Connect(function()
		self:Drop(thief, "died")
	end)
	carries[thief] = carry

	humanoid.WalkSpeed = Config.Steal.CarryWalkSpeed
	thief:SetAttribute("Carrying", Plushies.DisplayName(entry.Id, entry.Mutation))

	local name = Plushies.DisplayName(entry.Id, entry.Mutation)
	notify:FireClient(thief, `You grabbed {name}! Run back to your base!`, "success")
	notify:FireClient(owner, `⚠️ {thief.DisplayName} is stealing your {name}! Bonk them or touch them!`, "alert")
end

function StealService:_cleanup(thief: Player)
	local carry = carries[thief]
	if not carry then
		return
	end
	carries[thief] = nil
	if carry.DiedConnection then
		carry.DiedConnection:Disconnect()
	end
	carry.Model:Destroy()
	thief:SetAttribute("Carrying", nil)
	local humanoid = aliveParts(thief)
	if humanoid then
		humanoid.WalkSpeed = Services.MonetizationService:GetWalkSpeed(thief)
	end
end

-- Cancels a steal and sends the plushie back to its owner's pedestal.
function StealService:Drop(thief: Player, reason: string?)
	local carry = carries[thief]
	if not carry then
		return
	end
	local owner = carry.Owner
	self:_cleanup(thief)
	local base = BaseService:GetBase(owner)
	if base and base.Stealing[carry.Slot] == thief then
		base.Stealing[carry.Slot] = nil
		BaseService:RenderSlot(owner, carry.Slot)
	end
	if reason and thief.Parent then
		notify:FireClient(thief, `You dropped it ({reason}). It went back home.`, "error")
	end
	if owner.Parent and reason ~= "owner rebirthed" then
		notify:FireClient(owner, `Your {Plushies.DisplayName(carry.Entry.Id, carry.Entry.Mutation)} is safe again!`, "success")
	end
end

function StealService:_complete(thief: Player)
	local carry = carries[thief]
	if not carry then
		return
	end
	local owner = carry.Owner
	-- Make sure the owner still has exactly this plushie in that slot.
	local current = BaseService:GetEntry(owner, carry.Slot)
	if current ~= carry.Entry then
		self:Drop(thief, nil)
		return
	end
	if not BaseService:FindFreeSlot(thief) then
		self:Drop(thief, "your base is full")
		return
	end
	self:_cleanup(thief)
	local entry = BaseService:RemovePlushie(owner, carry.Slot)
	if not entry then
		return
	end
	BaseService:AddPlushie(thief, entry.Id, entry.Mutation)

	local data = Services.DataService:Get(thief)
	if data then
		data.Steals += 1
	end
	Services.EconomyService:RefreshStats(thief)

	local name = Plushies.DisplayName(entry.Id, entry.Mutation)
	notify:FireClient(thief, `You stole {name}! 😈`, "success")
	notify:FireClient(owner, `{thief.DisplayName} stole your {name}! Lock your base next time 🔒`, "alert")
	local def = Plushies.Get(entry.Id)
	if Config.Conveyor.AnnounceRarities[def.Rarity] then
		announce:FireAllClients(`{thief.DisplayName} STOLE {owner.DisplayName}'s {name}!`, Plushies.GetRarity(def.Rarity).Color)
	end
end

function StealService:CancelAllFor(player: Player)
	self:Drop(player, nil)
	for thief, carry in carries do
		if carry.Owner == player then
			self:Drop(thief, "owner rebirthed")
		end
	end
end

function StealService:Start()
	while true do
		task.wait(0.1)
		for thief, carry in carries do
			local _, root = aliveParts(thief)
			if not root or not thief.Parent then
				self:Drop(thief, "died")
				continue
			end
			local owner = carry.Owner
			if not owner.Parent or not BaseService:GetBase(owner) then
				self:_cleanup(thief)
				continue
			end
			local _, ownerRoot = aliveParts(owner)
			if ownerRoot and (ownerRoot.Position - root.Position).Magnitude <= Config.Steal.OwnerTagDistance then
				self:Drop(thief, `{owner.DisplayName} tagged you`)
				continue
			end
			if BaseService:IsInOwnBase(thief) then
				self:_complete(thief)
			end
		end
	end
end

function StealService:OnPlayerRemoving(player: Player)
	self:CancelAllFor(player)
end

return StealService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="25">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI and hooks up server messages.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = script.Parent:WaitForChild("UI")
local Effects = require(UI.Effects)
local Hud = require(UI.Hud)
local Notifications = require(UI.Notifications)
local Popups = require(UI.Popups)
local Shop = require(UI.Shop)

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "GameUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

Notifications.Init(gui)
Shop.Init(gui)
Popups.Init(gui)
Hud.Init(gui)
Effects.Init()

Remotes.Get("Notify").OnClientEvent:Connect(function(text: string, kind: string?)
	Notifications.Toast(text, kind)
end)
Remotes.Get("Announce").OnClientEvent:Connect(function(text: string, color: Color3?)
	Notifications.Announce(text, color)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="26">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Small client-side behaviours: prompt visibility, rainbow plushies, knockback, VIP chat tag.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local player = Players.LocalPlayer

local Effects = {}

-- Owners only see "Sell" on their plushies; everyone else only sees "Steal".
local function setupPromptFilter()
	local function apply(prompt: Instance, ownerOnly: boolean)
		if not prompt:IsA("ProximityPrompt") then
			return
		end
		local isMine = prompt:GetAttribute("OwnerId") == player.UserId
		prompt.Enabled = if ownerOnly then isMine else not isMine
	end
	for tag, ownerOnly in { OwnerOnlyPrompt = true, OthersOnlyPrompt = false } do
		for _, prompt in CollectionService:GetTagged(tag) do
			apply(prompt, ownerOnly)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(prompt)
			apply(prompt, ownerOnly)
		end)
	end
end

local function setupRainbow()
	local models: { [Instance]: boolean } = {}
	for _, model in CollectionService:GetTagged("Rainbow") do
		models[model] = true
	end
	CollectionService:GetInstanceAddedSignal("Rainbow"):Connect(function(model)
		models[model] = true
	end)
	CollectionService:GetInstanceRemovedSignal("Rainbow"):Connect(function(model)
		models[model] = nil
	end)
	RunService.RenderStepped:Connect(function()
		local hue = (os.clock() * 0.25) % 1
		for model in models do
			if not model.Parent then
				models[model] = nil
				continue
			end
			for _, part in model:GetChildren() do
				if part:IsA("BasePart") and part.Name ~= "Root" and part.Material == Enum.Material.Neon then
					part.Color = Color3.fromHSV(hue, 0.8, 1)
				end
			end
		end
	end)
end

local function setupKnockback()
	Remotes.Get("Knockback").OnClientEvent:Connect(function(velocity: Vector3)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
			root.AssemblyLinearVelocity = velocity
		end
	end)
end

local function setupChatTags()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local speaker = source and Players:GetPlayerByUserId(source.UserId)
		if speaker and speaker:GetAttribute("Pass_VIP") then
			properties.PrefixText = `<font color="#FFCD3C">[VIP]</font> {message.PrefixText}`
		end
		return properties
	end
end

function Effects.Init()
	setupPromptFilter()
	setupRainbow()
	setupKnockback()
	pcall(setupChatTags)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Always-visible HUD: cash, income, side buttons, status line, carry banner.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local Popups = require(script.Parent.Popups)
local Shop = require(script.Parent.Shop)
local Theme = require(script.Parent.Theme)

local player = Players.LocalPlayer

local Hud = {}

local function sideButton(parent: Instance, order: number, icon: string, text: string, color: Color3): (TextButton, TextLabel)
	local button = Theme.Button({
		LayoutOrder = order,
		Size = UDim2.fromScale(1, 0.3),
		BackgroundColor3 = color,
		Text = icon,
		Parent = parent,
	})
	Theme.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = button })
	Theme.Label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 14),
		Size = UDim2.new(1.3, 0, 0.32, 0),
		Text = text,
		ZIndex = 2,
		Parent = button,
	})
	local badge = Theme.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.92, 0.08),
		Size = UDim2.fromScale(0.36, 0.36),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		Text = "!",
		Visible = false,
		ZIndex = 3,
		Parent = button,
	})
	Theme.Corner(100).Parent = badge
	return button, badge
end

function Hud.Init(gui: ScreenGui)
	-- Cash panel (top center)
	local cashPanel = Theme.Create("Frame", {
		Name = "CashPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(280, 74),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, { Theme.Corner(14), Theme.Stroke(Theme.Colors.Green, 3) })
	local cashLabel = Theme.Label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -60, 0, 42),
		Text = "$0",
		TextColor3 = Theme.Colors.Cash,
		Parent = cashPanel,
	})
	local incomeLabel = Theme.Label({
		Position = UDim2.fromOffset(10, 46),
		Size = UDim2.new(1, -60, 0, 22),
		Text = "+$0/s",
		TextColor3 = Theme.Colors.Muted,
		Parent = cashPanel,
	})
	local plus = Theme.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Theme.Colors.Green,
		Text = "+",
		Parent = cashPanel,
	})
	plus.Activated:Connect(function()
		Shop.Show("Boosts")
	end)

	local statusLabel = Theme.Label({
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.fromOffset(420, 24),
		Text = "",
		Parent = gui,
	})
	local luckLabel = Theme.Label({
		Name = "Luck",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 108),
		Size = UDim2.fromOffset(420, 22),
		Text = "",
		TextColor3 = Color3.fromRGB(120, 255, 140),
		Visible = false,
		Parent = gui,
	})

	-- Side buttons (left)
	local side = Theme.Create("Frame", {
		Name = "SideButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.new(0, 70, 0.5, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 22),
		}),
		Theme.Create("UISizeConstraint", { MaxSize = Vector2.new(80, 330), MinSize = Vector2.new(50, 180) }),
	})
	local shopButton = sideButton(side, 1, "🛒", "Shop", Theme.Colors.Pink)
	local rebirthButton, rebirthBadge = sideButton(side, 2, "♻️", "Rebirth", Theme.Colors.Gold)
	local dailyButton, dailyBadge = sideButton(side, 3, "🎁", "Daily", Theme.Colors.Blue)
	shopButton.Activated:Connect(Shop.Toggle)
	rebirthButton.Activated:Connect(Popups.ToggleRebirth)
	dailyButton.Activated:Connect(Popups.ToggleDaily)

	-- Carry banner (bottom)
	local carryLabel = Theme.Label({
		Name = "Carry",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -300),
		Size = UDim2.new(0.8, 0, 0, 44),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 120, 60),
		Visible = false,
		Parent = gui,
	})
	Theme.Create("UISizeConstraint", { MaxSize = Vector2.new(700, 44), Parent = carryLabel })

	-- New player hint
	local hint = Theme.Label({
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -300),
		Size = UDim2.new(0.9, 0, 0, 30),
		Text = "Buy plushies on the conveyor 💰  •  Collect cash on the green pad  •  Steal from other bases 😈  •  Lock your base 🔒",
		TextColor3 = Theme.Colors.Gold,
		Visible = false,
		Parent = gui,
	})
	Theme.Create("UISizeConstraint", { MaxSize = Vector2.new(900, 30), Parent = hint })
	task.spawn(function()
		if not player:GetAttribute("Loaded") then
			player:GetAttributeChangedSignal("Loaded"):Wait()
		end
		if (player:GetAttribute("Rebirths") or 0) == 0 and (player:GetAttribute("PlushieCount") or 0) <= 2 then
			hint.Visible = true
			task.wait(90)
			hint.Visible = false
		end
	end)

	local function refresh()
		local cash = player:GetAttribute("Cash") or 0
		cashLabel.Text = Format.Cash(cash)
		local multiplier = player:GetAttribute("Multiplier") or 1
		incomeLabel.Text = `+{Format.Cash(player:GetAttribute("Income") or 0)}/s   x{Format.Number(multiplier)}`

		local now = workspace:GetServerTimeNow()
		local parts = {}
		local lockedUntil = player:GetAttribute("LockedUntil") or 0
		if lockedUntil > now then
			table.insert(parts, `🔒 Locked {math.ceil(lockedUntil - now)}s`)
		end
		local shieldUntil = player:GetAttribute("ShieldUntil") or 0
		if shieldUntil > os.time() then
			table.insert(parts, `🛡️ Shield {Format.Time(shieldUntil - os.time())}`)
		end
		local protectedUntil = player:GetAttribute("ProtectedUntil") or 0
		if protectedUntil > now then
			table.insert(parts, `✨ New player protection {math.ceil(protectedUntil - now)}s`)
		end
		local friends = player:GetAttribute("FriendsInServer") or 0
		if friends > 0 then
			table.insert(parts, `👥 +{math.floor((player:GetAttribute("FriendBonus") or 0) * 100)}% friend bonus`)
		end
		statusLabel.Text = table.concat(parts, "   ")

		local luckUntil = ReplicatedStorage:GetAttribute("ServerLuckUntil") or 0
		luckLabel.Visible = luckUntil > now
		if luckUntil > now then
			luckLabel.Text = `🍀 2x SERVER LUCK {Format.Time(luckUntil - now)} (thanks {ReplicatedStorage:GetAttribute("ServerLuckBy") or "someone"}!)`
		end

		local carrying = player:GetAttribute("Carrying")
		carryLabel.Visible = carrying ~= nil
		if carrying then
			carryLabel.Text = `😈 Carrying {carrying}! RUN BACK TO YOUR BASE!`
			hint.Visible = false
		end

		rebirthBadge.Visible = cash >= (player:GetAttribute("RebirthCost") or math.huge)
		dailyBadge.Visible = player:GetAttribute("DailyCanClaim") == true
	end

	task.spawn(function()
		while true do
			refresh()
			task.wait(0.2)
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[-- Toast messages (bottom of screen) and big server-wide announcements (top).

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Notifications = {}

local MAX_TOASTS = 4
local KIND_COLORS = {
	cash = Theme.Colors.Green,
	success = Theme.Colors.Green,
	error = Theme.Colors.Red,
	alert = Color3.fromRGB(255, 120, 40),
	info = Theme.Colors.Blue,
}

local container: Frame
local banner: TextLabel
local bannerToken = 0
local alertSound: Sound
local cashSound: Sound

function Notifications.Init(gui: ScreenGui)
	container = Theme.Create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.new(0.9, 0, 0, 190),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
		Theme.Create("UISizeConstraint", { MaxSize = Vector2.new(520, 190) }),
	})

	banner = Theme.Label({
		Name = "Announcement",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.new(0.8, 0, 0, 40),
		Text = "",
		Visible = false,
		Parent = gui,
	})
	Theme.Create("UISizeConstraint", { MaxSize = Vector2.new(800, 40), Parent = banner })

	alertSound = Theme.Create("Sound", { SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, Parent = SoundService })
	cashSound = Theme.Create("Sound", { SoundId = "rbxasset://sounds/clickfast.wav", Volume = 0.5, Parent = SoundService })
end

local order = 0
function Notifications.Toast(text: string, kind: string?)
	kind = kind or "info"
	order += 1
	local toasts = {}
	for _, child in container:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts >= MAX_TOASTS do
		local oldest = table.remove(toasts, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local label = Theme.Label({
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 0.15,
		BackgroundColor3 = KIND_COLORS[kind] or Theme.Colors.Blue,
		Text = text,
		Parent = container,
	})
	Theme.Corner(10).Parent = label
	Theme.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		Parent = label,
	})

	if kind == "alert" then
		alertSound:Play()
	elseif kind == "cash" then
		cashSound:Play()
	end

	task.delay(kind == "alert" and 6 or 3.5, function()
		if label.Parent then
			local tween = TweenService:Create(label, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			label:Destroy()
		end
	end)
end

function Notifications.Announce(text: string, color: Color3?)
	bannerToken += 1
	local token = bannerToken
	banner.Text = text
	banner.TextColor3 = color or Theme.Colors.Gold
	banner.Visible = true
	alertSound:Play()
	task.delay(6, function()
		if bannerToken == token then
			banner.Visible = false
		end
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Popups</string>
              <string name="Source"><![CDATA[-- Rebirth, daily reward and "welcome back" windows.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Shop = require(script.Parent.Shop)
local Theme = require(script.Parent.Theme)

local player = Players.LocalPlayer

local Popups = {}

local rebirthWindow: Frame
local dailyWindow: Frame
local offlineWindow: Frame
local refreshers = {}

local function attr(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function buildRebirth(gui: ScreenGui)
	local content
	rebirthWindow, content = Theme.Window(gui, "♻️ Rebirth", UDim2.fromScale(0.6, 0.55))
	local info = Theme.Label({
		Size = UDim2.new(1, 0, 0.4, 0),
		TextWrapped = true,
		Text = "",
		Parent = content,
	})
	local barBack = Theme.Create("Frame", {
		Position = UDim2.fromScale(0.05, 0.47),
		Size = UDim2.fromScale(0.9, 0.14),
		BackgroundColor3 = Theme.Colors.PanelLight,
		Parent = content,
	}, { Theme.Corner(8) })
	local barFill = Theme.Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Green,
		Parent = barBack,
	}, { Theme.Corner(8) })
	local barText = Theme.Label({ Size = UDim2.fromScale(1, 1), Text = "", Parent = barBack })
	local button = Theme.Button({
		Position = UDim2.fromScale(0.2, 0.7),
		Size = UDim2.fromScale(0.6, 0.25),
		BackgroundColor3 = Theme.Colors.Gold,
		Text = "REBIRTH",
		Parent = content,
	})
	button.Activated:Connect(function()
		Remotes.Get("RequestRebirth"):FireServer()
	end)

	table.insert(refreshers, function()
		local rebirths = attr("Rebirths", 0)
		local cost = attr("RebirthCost", Config.RebirthCost(0))
		local cash = attr("Cash", 0)
		local nextMultiplier = 1 + (rebirths + 1) * Config.Economy.RebirthMultiplierBonus
		info.Text = `Reset your cash and plushies to get a PERMANENT x{nextMultiplier} cash multiplier and +1 base slot.`
		barFill.Size = UDim2.fromScale(math.clamp(cash / cost, 0, 1), 1)
		barText.Text = `{Format.Cash(cash)} / {Format.Cash(cost)}`
		button.Text = if cash >= cost then "REBIRTH NOW!" else "Need " .. Format.Cash(cost)
	end)
end

local function buildDaily(gui: ScreenGui)
	local content
	dailyWindow, content = Theme.Window(gui, "🎁 Daily Reward", UDim2.fromScale(0.65, 0.55))
	local days = Theme.Create("Frame", {
		Size = UDim2.fromScale(1, 0.4),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		Theme.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0.01, 0),
		}),
	})
	local boxes = {}
	for day = 1, 7 do
		local box = Theme.Label({
			Size = UDim2.fromScale(0.13, 1),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Colors.PanelLight,
			Text = if day == Config.Daily.MysteryBoxDay then `Day {day}\n🎁` else `Day {day}\n💵`,
			Parent = days,
		})
		Theme.Corner(10).Parent = box
		boxes[day] = box
	end
	local info = Theme.Label({
		Position = UDim2.fromScale(0, 0.45),
		Size = UDim2.fromScale(1, 0.2),
		Text = "",
		Parent = content,
	})
	local button = Theme.Button({
		Position = UDim2.fromScale(0.2, 0.72),
		Size = UDim2.fromScale(0.6, 0.25),
		BackgroundColor3 = Theme.Colors.Green,
		Text = "CLAIM",
		Parent = content,
	})
	button.Activated:Connect(function()
		Remotes.Get("ClaimDaily"):FireServer()
	end)

	table.insert(refreshers, function()
		local streak = attr("DailyStreak", 1)
		local canClaim = attr("DailyCanClaim", false)
		for day, box in boxes do
			box.BackgroundColor3 = if day < streak or (day == streak and not canClaim)
				then Theme.Colors.Green
				elseif day == streak then Theme.Colors.Pink
				else Theme.Colors.PanelLight
		end
		local reward = Format.Cash(attr("DailyReward", 0))
		if canClaim then
			info.Text = `Day {streak}: {reward}` .. (if streak == Config.Daily.MysteryBoxDay then " + Mystery Box!" else "")
			button.Text = "CLAIM"
			button.BackgroundColor3 = Theme.Colors.Green
		else
			local wait = attr("DailyResetAt", 0) - os.time()
			info.Text = "Come back tomorrow to keep your streak!"
			button.Text = "Next in " .. Format.Time(wait)
			button.BackgroundColor3 = Theme.Colors.PanelLight
		end
	end)
end

local function buildOffline(gui: ScreenGui)
	local content
	offlineWindow, content = Theme.Window(gui, "🌙 Welcome back!", UDim2.fromScale(0.55, 0.45))
	local info = Theme.Label({
		Size = UDim2.fromScale(1, 0.5),
		TextWrapped = true,
		Text = "",
		Parent = content,
	})
	local upsell = Theme.Button({
		Position = UDim2.fromScale(0.1, 0.6),
		Size = UDim2.fromScale(0.8, 0.3),
		BackgroundColor3 = Theme.Colors.Gold,
		Text = "Earn 4x more offline 🌙",
		Parent = content,
	})
	upsell.Activated:Connect(function()
		offlineWindow.Visible = false
		Shop.Show("Passes")
	end)

	local function show()
		local amount = player:GetAttribute("OfflineEarned")
		if not amount then
			return
		end
		local seconds = attr("OfflineSeconds", 0)
		info.Text = `Your plushies earned {Format.Cash(amount)} while you were away ({Format.Time(seconds)}).`
		upsell.Visible = player:GetAttribute("Pass_OfflineEarnings") ~= true
		offlineWindow.Visible = true
	end
	player:GetAttributeChangedSignal("OfflineEarned"):Connect(show)
	show()
end

function Popups.Init(gui: ScreenGui)
	buildRebirth(gui)
	buildDaily(gui)
	buildOffline(gui)
	task.spawn(function()
		while true do
			for _, refresh in refreshers do
				refresh()
			end
			task.wait(0.5)
		end
	end)
end

function Popups.ToggleRebirth()
	rebirthWindow.Visible = not rebirthWindow.Visible
end

function Popups.ToggleDaily()
	dailyWindow.Visible = not dailyWindow.Visible
end

return Popups
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Robux shop: game passes and boosts (developer products).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Theme = require(script.Parent.Theme)

local player = Players.LocalPlayer
local requestPurchase = Remotes.Get("RequestPurchase")

local Shop = {}

local window: Frame
local pages: { [string]: ScrollingFrame } = {}
local tabButtons: { [string]: TextButton } = {}

local function makeCard(parent: Instance, item, kind: string, order: number)
	local card = Theme.Create("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = Theme.Colors.PanelLight,
		Parent = parent,
	}, { Theme.Corner(12) })
	Theme.Label({
		Size = UDim2.new(0.28, 0, 0.55, 0),
		Position = UDim2.fromScale(0.02, 0.05),
		Text = item.Icon,
		Parent = card,
	})
	Theme.Label({
		Size = UDim2.new(0.68, 0, 0.25, 0),
		Position = UDim2.fromScale(0.31, 0.05),
		Text = item.Name,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.Gold,
		Parent = card,
	})
	local description = Theme.Label({
		Size = UDim2.new(0.68, 0, 0.32, 0),
		Position = UDim2.fromScale(0.31, 0.3),
		Text = item.Description,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextColor3 = Theme.Colors.Muted,
		Parent = card,
	})
	description:FindFirstChildOfClass("UIStroke"):Destroy()

	local buy = Theme.Button({
		Size = UDim2.new(0.9, 0, 0.28, 0),
		Position = UDim2.fromScale(0.05, 0.67),
		BackgroundColor3 = Theme.Colors.Green,
		Text = "R$ " .. item.Price,
		Parent = card,
	})
	buy.Activated:Connect(function()
		requestPurchase:FireServer(kind, item.Key)
	end)

	if kind == "Pass" then
		local function refresh()
			local owns = player:GetAttribute("Pass_" .. item.Key) == true
			buy.Text = if owns then "Owned ✓" else "R$ " .. item.Price
			buy.BackgroundColor3 = if owns then Theme.Colors.PanelLight else Theme.Colors.Green
			buy.Active = not owns
		end
		player:GetAttributeChangedSignal("Pass_" .. item.Key):Connect(refresh)
		refresh()
	end
end

local function makePage(content: Frame, name: string, items, kind: string)
	local page = Theme.Create("ScrollingFrame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Visible = false,
		Parent = content,
	}, {
		Theme.Create("UIGridLayout", {
			CellSize = UDim2.new(0.5, -8, 0, 130),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for index, item in items do
		makeCard(page, item, kind, index)
	end
	pages[name] = page
end

function Shop.Show(tab: string?)
	tab = tab or "Boosts"
	for name, page in pages do
		page.Visible = name == tab
		tabButtons[name].BackgroundColor3 = if name == tab then Theme.Colors.Pink else Theme.Colors.PanelLight
	end
	window.Visible = true
end

function Shop.Toggle()
	if window.Visible then
		window.Visible = false
	else
		Shop.Show()
	end
end

function Shop.Init(gui: ScreenGui)
	local content
	window, content = Theme.Window(gui, "🛒 Shop", UDim2.fromScale(0.75, 0.75))
	local tabs = { "Boosts", "Passes" }
	for index, name in tabs do
		local button = Theme.Button({
			Size = UDim2.new(0.5, -6, 0, 42),
			Position = UDim2.new((index - 1) * 0.5, (index - 1) * 6, 0, 0),
			Text = name,
			Parent = content,
		})
		button.Activated:Connect(function()
			Shop.Show(name)
		end)
		tabButtons[name] = button
	end
	makePage(content, "Boosts", Config.Products, "Product")
	makePage(content, "Passes", Config.GamePasses, "Pass")
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Small helpers so every UI element shares the same look.

local Theme = {}

Theme.Font = Enum.Font.FredokaOne
Theme.Colors = {
	Panel = Color3.fromRGB(35, 30, 55),
	PanelLight = Color3.fromRGB(60, 52, 90),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(190, 185, 215),
	Cash = Color3.fromRGB(110, 255, 140),
	Pink = Color3.fromRGB(255, 110, 170),
	Gold = Color3.fromRGB(255, 205, 60),
	Red = Color3.fromRGB(255, 80, 90),
	Blue = Color3.fromRGB(90, 170, 255),
	Green = Color3.fromRGB(70, 210, 110),
}

function Theme.Create(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Theme.Corner(radius: number?): UICorner
	return Theme.Create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Theme.Stroke(color: Color3?, thickness: number?): UIStroke
	return Theme.Create("UIStroke", {
		Color = color or Color3.fromRGB(20, 15, 35),
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	local label = Theme.Create("TextLabel", defaults)
	Theme.Create("UIStroke", { Thickness = 2, Color = Color3.fromRGB(20, 15, 35), Parent = label })
	return label
end

function Theme.Button(props: { [string]: any }): TextButton
	local defaults = {
		BackgroundColor3 = Theme.Colors.Pink,
		Font = Theme.Font,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		AutoButtonColor = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = Theme.Create("TextButton", defaults)
	Theme.Corner(10).Parent = button
	Theme.Stroke().Parent = button
	Theme.Create("UIPadding", {
		PaddingTop = UDim.new(0.12, 0),
		PaddingBottom = UDim.new(0.12, 0),
		PaddingLeft = UDim.new(0.06, 0),
		PaddingRight = UDim.new(0.06, 0),
		Parent = button,
	})
	return button
end

-- A centered popup window with a title and close button. Returns (frame, content).
function Theme.Window(parent: Instance, title: string, size: UDim2): (Frame, Frame)
	local frame = Theme.Create("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = parent,
	}, { Theme.Corner(16), Theme.Stroke(Theme.Colors.Pink, 4) })
	Theme.Create("UISizeConstraint", { MaxSize = Vector2.new(720, 560), Parent = frame })
	Theme.Label({
		Size = UDim2.new(1, -80, 0, 44),
		Position = UDim2.fromOffset(16, 8),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.Gold,
		Parent = frame,
	})
	local close = Theme.Button({
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Text = "X",
		BackgroundColor3 = Theme.Colors.Red,
		Parent = frame,
	})
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	local content = Theme.Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 60),
		Size = UDim2.new(1, -24, 1, -72),
		Parent = frame,
	})
	return frame, content
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>